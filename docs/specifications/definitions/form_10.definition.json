{
  "schemaVersion": "1.0",
  "formId": "form_10",
  "formNumber": "10",
  "officialName": "Application for Amendment of Patent",
  "purpose": "Request that a granted patent be amended by substituting the applicant's name for the name of the grantee (e.g. to correct/substitute a deceased grantee), supported by documents.",
  "legalReference": {
    "act": ["THE PATENTS ACT, 1970 (39 of 1970)", "Section 44"],
    "rules": ["THE PATENTS RULES, 2003", "Rule 75"]
  },
  "pageCount": 1,
  "fee": { "model": "first_schedule", "note": "For fee: See First Schedule." },
  "layout": {
    "columns": 2,
    "notes": "Two-column form: left column carries numbered instructions (1-7); right column carries the form content with superscript markers. The applicant block (a)-(c) is pre-printed three times on the official face (space for up to three applicants); the editor allows adding/removing applicants dynamically rather than hard-capping at three (per instruction 1: repeat columns (a)-(c) for more than one applicant)."
  },

  "sections": [
    {
      "id": "applicants",
      "title": "Applicant(s) Requesting Substitution",
      "description": "Repeatable block (a)-(c); repeat per applicant (instruction 1). The (a) Name / (b) Address / (c) Nationality sub-fields are printed as a structured, labelled block, not a running sentence.",
      "fields": [
        {
          "id": "iwe",
          "kind": "strikeoutChoice",
          "label": "I/We",
          "required": true,
          "options": [
            { "value": "i", "label": "I" },
            { "value": "we", "label": "We" }
          ],
          "export": { "strikeoutUnselected": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Choose 'I' for a single applicant, 'We' for multiple, from the applicant count in the substitution documents.",
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "applicant",
          "kind": "group",
          "label": "Applicant",
          "repeatable": { "min": 1, "max": null, "itemLabel": "Applicant" },
          "fields": [
            {
              "id": "name",
              "kind": "text",
              "label": "(a) Name",
              "required": true,
              "helpText": "Name in full, family/principal name first.",
              "validation": { "minLength": 2, "message": "Enter the applicant's full name." },
              "autofill": {
                "strategy": "direct",
                "sources": [{ "sourceType": "assignment_document", "key": "assignee.name" }],
                "confidence": "medium"
              }
            },
            {
              "id": "address",
              "kind": "textarea",
              "label": "(b) Address",
              "format": "address",
              "required": true,
              "helpText": "Complete address incl postal index no./code, state and/or country.",
              "validation": { "minLength": 2, "message": "Enter the applicant's complete address." },
              "autofill": {
                "strategy": "direct",
                "sources": [{ "sourceType": "assignment_document", "key": "assignee.address" }],
                "confidence": "medium"
              }
            },
            {
              "id": "nationality",
              "kind": "text",
              "label": "(c) Nationality",
              "format": "country",
              "required": true,
              "validation": { "minLength": 2, "message": "Enter the applicant's nationality." },
              "autofill": {
                "strategy": "direct",
                "sources": [{ "sourceType": "assignment_document", "key": "assignee.nationality" }],
                "confidence": "medium"
              }
            }
          ]
        }
      ]
    },

    {
      "id": "patent_amendment",
      "title": "Patent to be Amended",
      "description": "Pre-printed: 'hereby request that Patent No.------ dated ...... granted to ...... may be amended by substituting my/our name for the name of the grantee and in support to my/our request, I/We furnish the following documents : ......'",
      "fields": [
        {
          "id": "clause_intro",
          "kind": "boilerplate",
          "text": "hereby request that Patent No.",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "patent_number",
          "kind": "text",
          "label": "Patent No.",
          "format": "patentNumber",
          "required": true,
          "validation": {
            "pattern": "^[A-Za-z0-9/-]{1,20}$",
            "patternMessage": "Enter the patent number."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patent.number" }],
            "confidence": "high"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_dated",
          "kind": "boilerplate",
          "text": "dated",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "patent_date",
          "kind": "date",
          "label": "Dated (of the patent/grant)",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patent.grantDate" }],
            "confidence": "high"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_granted_to",
          "kind": "boilerplate",
          "text": "granted to",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "granted_to",
          "kind": "textarea",
          "label": "Granted to (current grantee)",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the current grantee's name." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patentee.name" }],
            "confidence": "high"
          },
          "presentation": { "group": "patent", "multiline": true }
        },
        {
          "id": "clause_substituting",
          "kind": "boilerplate",
          "text": "may be amended by substituting",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "my_our",
          "kind": "strikeoutChoice",
          "label": "my / our",
          "required": true,
          "options": [
            { "value": "my", "label": "my" },
            { "value": "our", "label": "our" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_tail",
          "kind": "boilerplate",
          "text": "name for the name of the grantee and in support to my/our request, I/We furnish the following documents :",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "documents_furnished",
          "kind": "textarea",
          "label": "Documents furnished in support",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Document" },
          "helpText": "List the documents furnished in support of the substitution (e.g. assignment, legal representative/probate documents)."
        }
      ]
    },

    {
      "id": "address_for_service",
      "title": "Address for Service in India",
      "description": "Instruction 5: complete address incl postal index number/code and state along with telephone and fax number(s).",
      "fields": [
        {
          "id": "address_for_service",
          "kind": "textarea",
          "label": "My/our address for service in India",
          "format": "address",
          "required": true,
          "helpText": "Must be an address in India. Include postal index no./code, state, and telephone and fax number(s).",
          "validation": { "minLength": 2, "message": "Enter an address for service in India." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "applicant.address" }],
            "confidence": "low"
          }
        }
      ]
    },

    {
      "id": "signature",
      "title": "To be signed by the applicant(s) or his authorised registered patent agent.",
      "fields": [
        {
          "id": "statement_date",
          "kind": "date",
          "label": "Dated this __ day of __ 20__",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Default to the preparation / signing date; editable.",
            "confidence": "high"
          }
        },
        { "id": "signature", "kind": "signature", "label": "Signature", "required": true }
      ]
    },

    {
      "id": "signatory",
      "title": "Name of the natural person who has signed.",
      "fields": [
        {
          "id": "signatory_name",
          "kind": "text",
          "label": "Name of the natural person who has signed",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the full name of the natural person who signed." },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form26_authorisation", "key": "agent.name" },
              { "sourceType": "form1", "key": "signatory.name" }
            ],
            "confidence": "medium"
          }
        }
      ]
    },

    {
      "id": "addressee",
      "title": "To",
      "fields": [
        {
          "id": "addressee_boilerplate",
          "kind": "boilerplate",
          "text": "To\nThe Controller of Patents,\nThe Patent Office,\nat",
          "export": { "verbatim": true },
          "presentation": { "group": "addressee" }
        },
        {
          "id": "patent_office",
          "kind": "dropdown",
          "label": "at (Patent Office)",
          "format": "patentOffice",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "delhi", "label": "Delhi" },
            { "value": "mumbai", "label": "Mumbai" },
            { "value": "chennai", "label": "Chennai" },
            { "value": "kolkata", "label": "Kolkata" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Jurisdictional patent office based on the applicant's address or the office recorded on the patent.",
            "confidence": "medium"
          },
          "presentation": { "group": "addressee", "multiline": false }
        }
      ]
    }
  ],

  "attachments": [
    {
      "id": "substitution_documents",
      "label": "Documents supporting the substitution (e.g. assignment, legal representative/probate documents)",
      "required": true,
      "note": "Listed by the applicant in 'Documents furnished in support' and enclosed with the application."
    }
  ],

  "notes": [
    "Note. - For fee: See First Schedule.",
    "Note. - Strike out whichever is not applicable.",
    "Distinct from Form 13, which amends the application/specification/documents (s.57); Form 10 amends a granted patent's grantee name (s.44). Keep the two editors separate.",
    "The (a)-(c) applicant block is pre-printed three times on the official form face; the editor allows adding/removing applicants dynamically rather than hard-capping at three."
  ],

  "metadata": {
    "sourcePdf": "docs/Form_10.PDF",
    "transcribedFrom": "docs/specifications/form_10.md",
    "status": "draft",
    "authoredFrom": "docs/specifications/patterns/patterns.json",
    "printedHeader": {
      "formTitle": "FORM 10",
      "statute": "THE PATENTS ACT, 1970 (39 of 1970) and THE PATENTS RULES, 2003",
      "subject": "APPLICATION FOR AMENDMENT OF PATENT",
      "citation": "(See section 44 and rule 75)"
    }
  }
}
