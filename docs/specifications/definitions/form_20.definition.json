{
  "schemaVersion": "1.0",
  "formId": "form_20",
  "formNumber": "20",
  "officialName": "Application for Revision of Terms and Conditions of Licence",
  "purpose": "Used by a licensee holding a licence granted by the Controller to apply for revision of the terms and conditions of that licence, on the ground that they have proved more onerous than originally expected and the invention cannot be worked.",
  "legalReference": {
    "act": ["THE PATENTS ACT, 1970 (39 of 1970)", "Section 88(4)"],
    "rules": ["THE PATENTS RULES, 2003", "Rule 100"]
  },
  "pageCount": 1,
  "fee": { "model": "first_schedule", "note": "For fee: See First Schedule." },
  "layout": {
    "columns": 2,
    "notes": "Two-column form: left column carries the numbered instructions (1-3); right column carries a four-part declaration (i)-(iv). Fields sharing a presentation.group belong on the same printed line."
  },

  "sections": [
    {
      "id": "applicant",
      "title": "Name, address and nationality of the applicant(s).",
      "description": "Instruction 1: name, address and nationality of the applicant(s). The applicant is the licensee.",
      "fields": [
        {
          "id": "iwe",
          "kind": "strikeoutChoice",
          "label": "I/We",
          "required": true,
          "options": [
            { "value": "i", "label": "I" },
            { "value": "we", "label": "We" }
          ],
          "export": { "strikeoutUnselected": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Choose 'I' for a single applicant, 'We' for multiple, from the applicant count in uploaded documents.",
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "applicant_particulars",
          "kind": "textarea",
          "label": "Name, address and nationality of the applicant(s)",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Applicant" },
          "helpText": "Full name (family/principal name first), complete address incl postal index no./code and state, and nationality. The applicant is the licensee under the Controller-granted licence.",
          "validation": { "minLength": 2, "message": "Enter the applicant's name, address and nationality." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "applicant.name" }],
            "confidence": "low"
          },
          "presentation": { "group": "row1", "multiline": true }
        },
        {
          "id": "hereby_declare",
          "kind": "boilerplate",
          "text": "hereby declare:",
          "export": { "verbatim": true },
          "presentation": { "group": "row1" }
        }
      ]
    },

    {
      "id": "declaration_i_patent",
      "title": "Declaration (i) — The Patent",
      "description": "Pre-printed: '(i) that Patent No. ...... dated ...... was granted to ...... for which the patentee is ......'",
      "fields": [
        {
          "id": "clause_i_intro",
          "kind": "boilerplate",
          "text": "(i) that Patent No.",
          "export": { "verbatim": true },
          "presentation": { "group": "clause_i" }
        },
        {
          "id": "patent_number",
          "kind": "text",
          "label": "Patent No.",
          "format": "patentNumber",
          "required": true,
          "validation": {
            "pattern": "^[A-Za-z0-9/-]{1,20}$",
            "patternMessage": "Enter the patent number."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patent.number" }],
            "confidence": "high"
          },
          "presentation": { "group": "clause_i", "multiline": false }
        },
        {
          "id": "clause_i_dated",
          "kind": "boilerplate",
          "text": "dated",
          "export": { "verbatim": true },
          "presentation": { "group": "clause_i" }
        },
        {
          "id": "patent_date",
          "kind": "date",
          "label": "Dated (of the patent)",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patent.grantDate" }],
            "confidence": "high"
          },
          "presentation": { "group": "clause_i", "multiline": false }
        },
        {
          "id": "clause_i_granted_to",
          "kind": "boilerplate",
          "text": "was granted to",
          "export": { "verbatim": true },
          "presentation": { "group": "clause_i" }
        },
        {
          "id": "granted_to",
          "kind": "text",
          "label": "Granted to",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the party to whom the patent was granted." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patentee.name" }],
            "confidence": "high"
          },
          "presentation": { "group": "clause_i", "multiline": false }
        },
        {
          "id": "clause_i_for_which",
          "kind": "boilerplate",
          "text": "for which the patentee is",
          "export": { "verbatim": true },
          "presentation": { "group": "clause_i" }
        },
        {
          "id": "patentee",
          "kind": "text",
          "label": "Patentee",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the patentee's name." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patentee.name" }],
            "confidence": "high"
          },
          "presentation": { "group": "clause_i", "multiline": false }
        }
      ]
    },

    {
      "id": "declaration_ii_licence",
      "title": "Declaration (ii) — The Licence",
      "description": "Pre-printed: '(ii) that I/We am/are holding licence under the patent, granted by the Controller by an order dated ......'",
      "fields": [
        {
          "id": "clause_ii_intro",
          "kind": "boilerplate",
          "text": "(ii) that I/We",
          "export": { "verbatim": true },
          "presentation": { "group": "clause_ii" }
        },
        {
          "id": "am_are",
          "kind": "strikeoutChoice",
          "label": "am / are",
          "required": true,
          "options": [
            { "value": "am", "label": "am" },
            { "value": "are", "label": "are" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "clause_ii", "multiline": false }
        },
        {
          "id": "clause_ii_holding",
          "kind": "boilerplate",
          "text": "holding licence under the patent, granted by the Controller by an order dated",
          "export": { "verbatim": true },
          "presentation": { "group": "clause_ii" }
        },
        {
          "id": "licence_order_date",
          "kind": "date",
          "label": "Licence order date",
          "required": true,
          "helpText": "The date of the Controller's order granting the licence.",
          "validation": { "notFuture": true },
          "presentation": { "group": "clause_ii", "multiline": false }
        }
      ]
    },

    {
      "id": "declaration_iii_grounds",
      "title": "Declaration (iii) — Grounds for Revision",
      "fields": [
        {
          "id": "clause_iii",
          "kind": "boilerplate",
          "text": "(iii) that the terms and conditions settled by the Controller have proved to be more onerous than originally expected and we are unable to work the invention.",
          "export": { "verbatim": true }
        }
      ]
    },

    {
      "id": "declaration_iv_statement",
      "title": "Declaration (iv) — Accompanying Statement and Request",
      "fields": [
        {
          "id": "clause_iv",
          "kind": "boilerplate",
          "text": "that the circumstances in which this application is made are set forth in the accompanying statement in duplicate.",
          "export": { "verbatim": true }
        },
        {
          "id": "request",
          "kind": "boilerplate",
          "text": "I/We request the Controller to revise the terms and conditions of the licence.",
          "export": { "verbatim": true }
        }
      ]
    },

    {
      "id": "signature",
      "title": "To be signed by the applicant(s) or by his authorised registered patent agent.",
      "fields": [
        {
          "id": "statement_date",
          "kind": "date",
          "label": "Dated this __ day of __ 20__",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Default to the preparation / signing date; editable.",
            "confidence": "high"
          }
        },
        { "id": "signature", "kind": "signature", "label": "Signature", "required": true }
      ]
    },

    {
      "id": "signatory",
      "title": "Name of the natural person who has signed.",
      "fields": [
        {
          "id": "signatory_name",
          "kind": "text",
          "label": "Name of the natural person who has signed",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the full name of the natural person who signed." },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form26_authorisation", "key": "agent.name" },
              { "sourceType": "form1", "key": "signatory.name" }
            ],
            "confidence": "medium"
          }
        }
      ]
    },

    {
      "id": "addressee",
      "title": "To",
      "fields": [
        {
          "id": "addressee_boilerplate",
          "kind": "boilerplate",
          "text": "To\nThe Controller of Patents,\nThe Patent Office,\nat",
          "export": { "verbatim": true },
          "presentation": { "group": "addressee" }
        },
        {
          "id": "patent_office",
          "kind": "dropdown",
          "label": "at (Patent Office)",
          "format": "patentOffice",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "delhi", "label": "Delhi" },
            { "value": "mumbai", "label": "Mumbai" },
            { "value": "chennai", "label": "Chennai" },
            { "value": "kolkata", "label": "Kolkata" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Jurisdictional patent office based on the applicant's address or the office recorded on the patent.",
            "confidence": "medium"
          },
          "presentation": { "group": "addressee", "multiline": false }
        }
      ]
    }
  ],

  "attachments": [
    {
      "id": "circumstances_statement",
      "label": "Statement setting out the circumstances in which this application is made",
      "required": true,
      "inDuplicate": true,
      "note": "Declaration (iv): the circumstances are set forth in the accompanying statement in duplicate."
    }
  ],

  "notes": [
    "Note. - For fee: See First Schedule.",
    "Note. - Strike out whichever is not applicable.",
    "Precondition: the applicant must already hold a Controller-granted licence under the patent (declaration (ii)).",
    "Transcription note: the source PDF mislabels the third sub-item as '(i)'; the intended printed sequence is (i), (ii), (iii), (iv), which is what this definition reproduces."
  ],

  "metadata": {
    "sourcePdf": "docs/Form_20.PDF",
    "transcribedFrom": "docs/specifications/form_20.md",
    "status": "draft",
    "authoredFrom": "docs/specifications/patterns/patterns.json",
    "printedHeader": {
      "formTitle": "FORM 20",
      "statute": "THE PATENTS ACT, 1970 (39 of 1970) and THE PATENTS RULES, 2003",
      "subject": "APPLICATION FOR REVISION OF TERMS AND CONDITIONS OF LICENCE",
      "citation": "(See section 88(4) and rule 100)"
    }
  }
}
