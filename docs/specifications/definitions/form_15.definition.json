{
  "schemaVersion": "1.0",
  "formId": "form_15",
  "formNumber": "15",
  "officialName": "Application for the Restoration of Patent",
  "purpose": "Apply for an order of the Controller restoring a patent that lapsed due to non-payment of the renewal fee, explaining the circumstances of the failure and declaring that the patent has not been assigned.",
  "legalReference": {
    "act": ["THE PATENTS ACT, 1970 (39 of 1970)", "Section 60"],
    "rules": ["THE PATENTS RULES, 2003", "Rule 84"]
  },
  "pageCount": 1,
  "fee": { "model": "first_schedule", "note": "For fee: See First Schedule." },
  "layout": {
    "columns": 2,
    "notes": "Two-column form: left column carries the numbered instructions; right column carries the running application with inline blanks. Fields sharing a presentation.group belong on the same printed line."
  },

  "sections": [
    {
      "id": "applicant",
      "title": "1. Name, address and nationality of the applicant(s).",
      "fields": [
        {
          "id": "iwe",
          "kind": "strikeoutChoice",
          "label": "I/We",
          "required": true,
          "options": [
            { "value": "i", "label": "I" },
            { "value": "we", "label": "We" }
          ],
          "export": { "strikeoutUnselected": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Choose 'I' for a single applicant, 'We' for multiple, from the applicant count in uploaded documents.",
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "applicant_particulars",
          "kind": "textarea",
          "label": "Name, address and nationality of the applicant(s)",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Applicant" },
          "helpText": "The applicant for restoration is normally the patentee. Name in full, complete address incl postal index no./code and state, and nationality.",
          "validation": { "minLength": 2, "message": "Enter the applicant's name, address and nationality." },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "patent_certificate", "key": "patentee.name" },
              { "sourceType": "form1", "key": "applicant.name" }
            ],
            "confidence": "medium"
          },
          "presentation": { "group": "row1", "multiline": true }
        }
      ]
    },

    {
      "id": "patent",
      "title": "2. Patent to be restored",
      "description": "Pre-printed: 'hereby apply for an order of the Controller for the restoration of Patent No. ... dated ... granted to ...'",
      "fields": [
        {
          "id": "restore_intro",
          "kind": "boilerplate",
          "text": "hereby apply for an order of the Controller for the restoration of Patent No.",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "patent_number",
          "kind": "text",
          "label": "Patent No.",
          "format": "patentNumber",
          "required": true,
          "validation": {
            "pattern": "^[A-Za-z0-9/-]{1,20}$",
            "patternMessage": "Enter the patent number."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patent.number" }],
            "confidence": "high"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "patent_dated",
          "kind": "boilerplate",
          "text": "dated",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "patent_date",
          "kind": "date",
          "label": "Date of the patent",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patent.grantDate" }],
            "confidence": "high"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "patent_granted_to",
          "kind": "boilerplate",
          "text": "granted to",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "granted_to",
          "kind": "textarea",
          "label": "Granted to",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the patentee(s) to whom the patent was granted." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patentee.name" }],
            "confidence": "high"
          },
          "presentation": { "group": "patent", "multiline": true }
        }
      ]
    },

    {
      "id": "circumstances",
      "title": "3. Circumstances which led to the failure to pay the renewal fee",
      "description": "Pre-printed: 'The circumstances which led to the failure to pay the renewal fee for the year ... on or before ... are as follows: ...'",
      "fields": [
        {
          "id": "circumstances_intro",
          "kind": "boilerplate",
          "text": "The circumstances which led to the failure to pay the renewal fee for the year",
          "export": { "verbatim": true },
          "presentation": { "group": "circumstances" }
        },
        {
          "id": "renewal_year",
          "kind": "text",
          "label": "Renewal-fee year",
          "required": true,
          "validation": {
            "pattern": "^[0-9]{4}(-[0-9]{4})?$",
            "patternMessage": "Enter the renewal-fee year, e.g. 2021 or 2020-2021."
          },
          "presentation": { "group": "circumstances", "multiline": false }
        },
        {
          "id": "circumstances_on_before",
          "kind": "boilerplate",
          "text": "on or before",
          "export": { "verbatim": true },
          "presentation": { "group": "circumstances" }
        },
        {
          "id": "due_date",
          "kind": "date",
          "label": "Due date (on or before)",
          "required": true,
          "presentation": { "group": "circumstances", "multiline": false }
        },
        {
          "id": "circumstances_are_as_follows",
          "kind": "boilerplate",
          "text": "are as follows:",
          "export": { "verbatim": true },
          "presentation": { "group": "circumstances" }
        },
        {
          "id": "circumstances_text",
          "kind": "textarea",
          "label": "Circumstances (reasons)",
          "required": true,
          "validation": { "minLength": 1, "message": "State the circumstances that led to the failure to pay the renewal fee." },
          "presentation": { "group": "circumstances", "multiline": true }
        }
      ]
    },

    {
      "id": "declaration",
      "title": "4. Declaration",
      "fields": [
        {
          "id": "declaration_text",
          "kind": "boilerplate",
          "text": "I/We declare that I/We have not assigned the patent to any other person(s) and that the facts and matters stated herein are true to the best of my/our knowledge information and belief.",
          "export": { "verbatim": true }
        },
        {
          "id": "statement_date",
          "kind": "date",
          "label": "Dated this __ day of __ 20__",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Default to the preparation / signing date; editable.",
            "confidence": "high"
          }
        }
      ]
    },

    {
      "id": "signature",
      "title": "To be signed by the applicant(s) or by his authorised registered patent agent.",
      "fields": [
        { "id": "signature", "kind": "signature", "label": "Signature", "required": true }
      ]
    },

    {
      "id": "signatory",
      "title": "Name of the natural person who has signed.",
      "fields": [
        {
          "id": "signatory_name",
          "kind": "text",
          "label": "Name of the natural person who has signed",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the full name of the natural person who signed." },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form26_authorisation", "key": "agent.name" },
              { "sourceType": "form1", "key": "signatory.name" }
            ],
            "confidence": "medium"
          }
        }
      ]
    },

    {
      "id": "addressee",
      "title": "To",
      "fields": [
        {
          "id": "addressee_boilerplate",
          "kind": "boilerplate",
          "text": "To\nThe Controller of Patents,\nThe Patent Office,\nat",
          "export": { "verbatim": true },
          "presentation": { "group": "addressee" }
        },
        {
          "id": "patent_office",
          "kind": "dropdown",
          "label": "at (Patent Office)",
          "format": "patentOffice",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "delhi", "label": "Delhi" },
            { "value": "mumbai", "label": "Mumbai" },
            { "value": "chennai", "label": "Chennai" },
            { "value": "kolkata", "label": "Kolkata" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Jurisdictional patent office based on the patentee's address or the office recorded on the patent.",
            "confidence": "medium"
          },
          "presentation": { "group": "addressee", "multiline": false }
        }
      ]
    }
  ],

  "notes": [
    "Note. - For fee: See First Schedule.",
    "Note. - Strike out whichever is not applicable.",
    "The declaration of non-assignment is mandatory content.",
    "Restoration under Section 60 must be applied for within the statutory window after the patent ceased; surface the deadline."
  ],

  "metadata": {
    "sourcePdf": "docs/Form_15.PDF",
    "transcribedFrom": "docs/specifications/form_15.md",
    "status": "draft",
    "authoredFrom": "docs/specifications/patterns/patterns.json",
    "printedHeader": {
      "formTitle": "FORM 15",
      "statute": "THE PATENTS ACT, 1970 (39 of 1970) and THE PATENTS RULES, 2003",
      "subject": "APPLICATION FOR THE RESTORATION OF PATENT",
      "citation": "(See section 60 and rule 84)"
    }
  }
}
