{
  "schemaVersion": "1.0",
  "formId": "form_09",
  "formNumber": "9",
  "officialName": "Request for Publication",
  "purpose": "Request early publication of a patent application ahead of the ordinary 18-month publication, under Section 11A(2).",
  "legalReference": {
    "act": ["THE PATENTS ACT, 1970 (39 of 1970)", "Section 11A(2)"],
    "rules": ["THE PATENTS RULES, 2003", "Rule 24A"]
  },
  "pageCount": 1,
  "fee": { "model": "first_schedule", "note": "For fee: See First Schedule." },
  "layout": {
    "columns": 2,
    "notes": "Two-column form: left column carries the numbered instruction labels; right column carries the running declaration with inline blanks. Fields sharing a presentation.group belong on the same printed line."
  },

  "sections": [
    {
      "id": "applicant",
      "title": "1. Name, address and nationality of the applicant(s).",
      "fields": [
        {
          "id": "iwe",
          "kind": "strikeoutChoice",
          "label": "I/We",
          "required": true,
          "options": [
            { "value": "i", "label": "I" },
            { "value": "we", "label": "We" }
          ],
          "export": { "strikeoutUnselected": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Choose 'I' for a single applicant, 'We' for multiple, from the applicant count in uploaded documents.",
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "applicant_particulars",
          "kind": "textarea",
          "label": "Name, address and nationality of the applicant(s)",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Applicant" },
          "helpText": "Full name (family/principal name first), complete address incl postal index no./code and state, and nationality.",
          "validation": {
            "minLength": 2,
            "message": "Enter the applicant's name, address and nationality."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form1", "key": "applicant.name" },
              { "sourceType": "form2_specification", "key": "applicant.name" }
            ],
            "confidence": "medium"
          },
          "presentation": { "group": "row1", "multiline": true }
        }
      ]
    },

    {
      "id": "request",
      "title": "2. Application to be published.",
      "description": "The right-column request sentence: 'hereby request for early publication of my/our Patent application No ... dated ... under section 11A(2) of the Act.'",
      "fields": [
        {
          "id": "request_intro",
          "kind": "boilerplate",
          "text": "hereby request for early publication of",
          "export": { "verbatim": true },
          "presentation": { "group": "request" }
        },
        {
          "id": "my_our",
          "kind": "strikeoutChoice",
          "label": "my / our",
          "options": [
            { "value": "my", "label": "my" },
            { "value": "our", "label": "our" }
          ],
          "export": { "strikeoutUnselected": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "'my' for a single applicant, 'our' for multiple; agrees with the I/We choice.",
            "confidence": "medium"
          },
          "presentation": { "group": "request", "multiline": false }
        },
        {
          "id": "request_application_no",
          "kind": "boilerplate",
          "text": "Patent application No",
          "export": { "verbatim": true },
          "presentation": { "group": "request" }
        },
        {
          "id": "application_number",
          "kind": "text",
          "label": "Patent application No.",
          "format": "applicationNumber",
          "required": true,
          "validation": {
            "pattern": "^([0-9]{11,12}|[0-9]{1,6}/[A-Za-z]{2,5}/[0-9]{4})$",
            "patternMessage": "Expected an IPO application number, e.g. 202211012345 or 1234/DEL/2015."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "application.number" }],
            "confidence": "high"
          },
          "presentation": { "group": "request", "multiline": false }
        },
        {
          "id": "request_dated",
          "kind": "boilerplate",
          "text": "dated",
          "export": { "verbatim": true },
          "presentation": { "group": "request" }
        },
        {
          "id": "application_date",
          "kind": "date",
          "label": "Date of the application",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "application.filingDate" }],
            "confidence": "high"
          },
          "presentation": { "group": "request", "multiline": false }
        },
        {
          "id": "request_section",
          "kind": "boilerplate",
          "text": "under section 11A(2) of the Act.",
          "export": { "verbatim": true },
          "presentation": { "group": "request" }
        }
      ]
    },

    {
      "id": "signature",
      "title": "To be signed by the applicant or his authorized registered patent agent.",
      "fields": [
        {
          "id": "statement_date",
          "kind": "date",
          "label": "Dated this __ day of __ 20__",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Default to the preparation / signing date; editable.",
            "confidence": "high"
          }
        },
        { "id": "signature", "kind": "signature", "label": "Signature", "required": true }
      ]
    },

    {
      "id": "signatory",
      "title": "Name of the natural person who has signed.",
      "fields": [
        {
          "id": "signatory_name",
          "kind": "text",
          "label": "Name of the natural person who has signed",
          "required": true,
          "validation": {
            "minLength": 2,
            "message": "Enter the full name of the natural person who signed."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form26_authorisation", "key": "agent.name" },
              { "sourceType": "form1", "key": "signatory.name" }
            ],
            "confidence": "medium"
          }
        }
      ]
    },

    {
      "id": "addressee",
      "title": "To",
      "fields": [
        {
          "id": "addressee_boilerplate",
          "kind": "boilerplate",
          "text": "To\nThe Controller of Patents,\nThe Patent Office,\nat",
          "export": { "verbatim": true },
          "presentation": { "group": "addressee" }
        },
        {
          "id": "patent_office",
          "kind": "dropdown",
          "label": "at (Patent Office)",
          "format": "patentOffice",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "delhi", "label": "Delhi" },
            { "value": "mumbai", "label": "Mumbai" },
            { "value": "chennai", "label": "Chennai" },
            { "value": "kolkata", "label": "Kolkata" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Jurisdictional patent office based on the applicant's address or the office recorded on Form 1.",
            "confidence": "medium"
          },
          "presentation": { "group": "addressee", "multiline": false }
        }
      ]
    }
  ],

  "notes": [
    "Note. - Strike out whichever is not applicable.",
    "For fee: See First Schedule.",
    "Almost every field derives from Form 1 — this form is a strong candidate for near-complete pre-fill, leaving only confirmation and signature."
  ],

  "metadata": {
    "sourcePdf": "docs/Form_9.PDF",
    "transcribedFrom": "docs/specifications/form_09.md",
    "status": "draft",
    "authoredFrom": "docs/specifications/patterns/patterns.json",
    "printedHeader": {
      "formTitle": "FORM 9",
      "statute": "THE PATENTS ACT, 1970 (39 of 1970) and THE PATENTS RULES, 2003",
      "subject": "REQUEST FOR PUBLICATION",
      "citation": "(See section 11A(2) and rule 24A)"
    }
  }
}
