{
  "schemaVersion": "1.0",
  "formId": "form_19",
  "formNumber": "19",
  "officialName": "Application for Revocation of a Patent for Non Working",
  "purpose": "Apply for revocation of a patent on the ground of non-working (failure to work the patented invention in India), stating the applicant's interest, the reasons/grounds, and the documentary evidence relied upon.",
  "legalReference": {
    "act": ["THE PATENTS ACT, 1970 (39 of 1970)", "Section 85(1)"],
    "rules": ["THE PATENTS RULES, 2003", "Rule 96"]
  },
  "pageCount": 1,
  "fee": { "model": "first_schedule", "note": "For fee: See First Schedule." },
  "layout": {
    "columns": 2,
    "notes": "Two-column form: left column carries the numbered instructions (1-6); right column carries the running application with inline blanks and superscript markers. Fields sharing a presentation.group belong on the same printed line."
  },

  "sections": [
    {
      "id": "applicant",
      "title": "Name, address and nationality of the applicant(s).",
      "description": "Instruction 1: name, address and nationality of the applicant(s).",
      "fields": [
        {
          "id": "iwe",
          "kind": "strikeoutChoice",
          "label": "I/We",
          "required": true,
          "options": [
            { "value": "i", "label": "I" },
            { "value": "we", "label": "We" }
          ],
          "export": { "strikeoutUnselected": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Choose 'I' for a single applicant, 'We' for multiple, from the applicant count in uploaded documents.",
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "applicant_particulars",
          "kind": "textarea",
          "label": "Name, address and nationality of the applicant(s)",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Applicant" },
          "helpText": "Full name (family/principal name first), complete address incl postal index no./code and state, and nationality. The applicant is typically an interested third party, not the patentee.",
          "validation": { "minLength": 2, "message": "Enter the applicant's name, address and nationality." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "applicant.name" }],
            "confidence": "low"
          },
          "presentation": { "group": "row1", "multiline": true }
        }
      ]
    },

    {
      "id": "patent",
      "title": "Patent to be Revoked and Reason",
      "description": "Pre-printed: 'hereby apply for revocation of Patent No. ...... dated ...... granted to ...... for which the patentee/applicant for patent is ...... for the following reason, namely: ......'",
      "fields": [
        {
          "id": "clause_intro",
          "kind": "boilerplate",
          "text": "hereby apply for revocation of Patent No.",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "patent_number",
          "kind": "text",
          "label": "Patent No.",
          "format": "patentNumber",
          "required": true,
          "validation": {
            "pattern": "^[A-Za-z0-9/-]{1,20}$",
            "patternMessage": "Enter the patent number."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patent.number" }],
            "confidence": "high"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_dated",
          "kind": "boilerplate",
          "text": "dated",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "patent_date",
          "kind": "date",
          "label": "Dated (of the patent)",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patent.grantDate" }],
            "confidence": "high"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_granted_to",
          "kind": "boilerplate",
          "text": "granted to",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "granted_to",
          "kind": "text",
          "label": "Granted to",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the party to whom the patent was granted." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patentee.name" }],
            "confidence": "high"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_for_which",
          "kind": "boilerplate",
          "text": "for which the",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "patentee_or_applicant",
          "kind": "strikeoutChoice",
          "label": "patentee / applicant for patent",
          "required": true,
          "options": [
            { "value": "patentee", "label": "patentee" },
            { "value": "applicant", "label": "applicant for patent" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_is",
          "kind": "boilerplate",
          "text": "is",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "patentee_name",
          "kind": "text",
          "label": "Patentee / applicant for patent",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the patentee (or applicant for patent)." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patentee.name" }],
            "confidence": "high"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_reason",
          "kind": "boilerplate",
          "text": "for the following reason, namely:",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "reasons",
          "kind": "textarea",
          "label": "Reason(s) / grounds",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Reason" },
          "helpText": "Instruction 2: state the nature of your interest, the facts relied on, and the grounds.",
          "validation": { "minLength": 1, "message": "State the reason(s) for seeking revocation." }
        }
      ]
    },

    {
      "id": "evidence",
      "title": "Documentary Evidence",
      "description": "Pre-printed: 'The details of documentary evidence in support of my/our interest and the reasons stated above are given below: (a) ...... (b) ...... (c) ......'",
      "fields": [
        {
          "id": "evidence_intro",
          "kind": "boilerplate",
          "text": "The details of documentary evidence in support of",
          "export": { "verbatim": true },
          "presentation": { "group": "evidence" }
        },
        {
          "id": "my_our",
          "kind": "strikeoutChoice",
          "label": "my / our",
          "options": [
            { "value": "my", "label": "my" },
            { "value": "our", "label": "our" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "evidence", "multiline": false }
        },
        {
          "id": "evidence_tail",
          "kind": "boilerplate",
          "text": "interest and the reasons stated above are given below:",
          "export": { "verbatim": true },
          "presentation": { "group": "evidence" }
        },
        {
          "id": "evidence_item",
          "kind": "text",
          "label": "Documentary evidence",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Document" },
          "helpText": "List each document relied upon, as printed items (a), (b), (c).",
          "validation": { "minLength": 1, "message": "List at least one document in support." }
        }
      ]
    },

    {
      "id": "declaration_and_service",
      "title": "Declaration and Address for Service",
      "description": "Instruction 4: complete address incl postal index number/code and state along with telephone and fax number(s).",
      "fields": [
        {
          "id": "truth_declaration",
          "kind": "boilerplate",
          "text": "I/We declare that the facts and matters stated herein are true to the best of my/our knowledge, information and belief.",
          "export": { "verbatim": true }
        },
        {
          "id": "address_for_service",
          "kind": "textarea",
          "label": "My/Our address for service in India",
          "format": "address",
          "required": true,
          "helpText": "Must be an address in India. Include postal index no./code, state, and telephone and fax number(s).",
          "validation": { "minLength": 2, "message": "Enter an address for service in India." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "applicant.address" }],
            "confidence": "low"
          }
        }
      ]
    },

    {
      "id": "signature",
      "title": "To be signed by the applicant(s) or his authorized registered patent agent.",
      "fields": [
        {
          "id": "statement_date",
          "kind": "date",
          "label": "Dated this __ day of __ 20__",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Default to the preparation / signing date; editable.",
            "confidence": "high"
          }
        },
        { "id": "signature", "kind": "signature", "label": "Signature", "required": true }
      ]
    },

    {
      "id": "signatory",
      "title": "Name of the natural person who has signed.",
      "fields": [
        {
          "id": "signatory_name",
          "kind": "text",
          "label": "Name of the natural person who has signed",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the full name of the natural person who signed." },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form26_authorisation", "key": "agent.name" },
              { "sourceType": "form1", "key": "signatory.name" }
            ],
            "confidence": "medium"
          }
        }
      ]
    },

    {
      "id": "addressee",
      "title": "To",
      "fields": [
        {
          "id": "addressee_boilerplate",
          "kind": "boilerplate",
          "text": "To\nThe Controller of Patents,\nThe Patent Office,\nat",
          "export": { "verbatim": true },
          "presentation": { "group": "addressee" }
        },
        {
          "id": "patent_office",
          "kind": "dropdown",
          "label": "at (Patent Office)",
          "format": "patentOffice",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "delhi", "label": "Delhi" },
            { "value": "mumbai", "label": "Mumbai" },
            { "value": "chennai", "label": "Chennai" },
            { "value": "kolkata", "label": "Kolkata" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Jurisdictional patent office based on the applicant's address or the office recorded on the patent.",
            "confidence": "medium"
          },
          "presentation": { "group": "addressee", "multiline": false }
        }
      ]
    }
  ],

  "attachments": [
    {
      "id": "evidence_documents",
      "label": "Certified copies of all the documentary evidence relied upon",
      "required": true,
      "inDuplicate": true,
      "note": "Instruction 3: certified copies of all the documents are to be enclosed in duplicate."
    }
  ],

  "notes": [
    "Note. - For fee: See First Schedule.",
    "Note. - Strike out whichever is not applicable.",
    "Certified copies of all the documents are to be enclosed in duplicate (instruction 3).",
    "Instruction 2 requires the applicant to state the nature of their interest, the facts relied on, and the grounds."
  ],

  "metadata": {
    "sourcePdf": "docs/Form_19.PDF",
    "transcribedFrom": "docs/specifications/form_19.md",
    "status": "draft",
    "authoredFrom": "docs/specifications/patterns/patterns.json",
    "printedHeader": {
      "formTitle": "FORM 19",
      "statute": "THE PATENTS ACT, 1970 (39 of 1970) and THE PATENTS RULES, 2003",
      "subject": "APPLICATION FOR REVOCATION OF A PATENT FOR NON WORKING",
      "citation": "(See section 85(1) and rule 96)"
    }
  }
}
