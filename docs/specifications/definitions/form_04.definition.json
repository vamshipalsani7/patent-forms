{
  "schemaVersion": "1.0",
  "formId": "form_04",
  "formNumber": "4",
  "officialName": "Request for Extension of Time or Condonation of Delay",
  "purpose": "Request an extension of time, or condonation of delay, in respect of an act or step under the Act/Rules in connection with a specified application or patent, stating the period sought, the enabling section/rule, and the reasons.",
  "legalReference": {
    "act": ["THE PATENTS ACT, 1970 (39 of 1970)", "Sections 53(2) and 142(4)"],
    "rules": ["THE PATENTS RULES, 2003", "Rules 12(5), 13(6), 24B(6), 24C(11), 80(1A), 130, 131(2) and 138"]
  },
  "pageCount": 1,
  "fee": {
    "model": "first_schedule",
    "note": "For fee: See First Schedule.",
    "dependsOn": ["months_requested", "applicant_category"]
  },
  "layout": {
    "columns": 2,
    "notes": "Two-column table with three numbered rows. Row 1's right column is a single running declaration with several inline blanks; fields sharing a presentation.group belong on the same printed line."
  },

  "sections": [
    {
      "id": "request",
      "title": "1. Name of the applicant",
      "description": "Row 1 right column: 'I/We ... hereby request for extension of time for ... month(s) under section/rule ... in connection with my/our application/Patent No ... The reasons for making the request are as follows:- ... Dated this ... day of ... 20...'",
      "fields": [
        {
          "id": "iwe",
          "kind": "strikeoutChoice",
          "label": "I/We",
          "required": true,
          "options": [
            { "value": "i", "label": "I" },
            { "value": "we", "label": "We" }
          ],
          "export": { "strikeoutUnselected": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Choose 'I' for a single applicant, 'We' for multiple, from the applicant count in uploaded documents.",
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "applicant_names",
          "kind": "textarea",
          "label": "Name of the applicant",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Applicant" },
          "validation": {
            "minLength": 2,
            "message": "Enter the applicant's name."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form1", "key": "applicant.name" },
              { "sourceType": "form2_specification", "key": "applicant.name" },
              { "sourceType": "patent_certificate", "key": "applicant.name" }
            ],
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": true }
        },
        {
          "id": "request_intro",
          "kind": "boilerplate",
          "text": "hereby request for extension of time for",
          "export": { "verbatim": true },
          "presentation": { "group": "row1" }
        },
        {
          "id": "months_requested",
          "kind": "number",
          "label": "Extension period (months)",
          "required": true,
          "validation": {
            "min": 1,
            "message": "Enter a whole number of months, within the maximum permitted by the cited section/rule."
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "request_months_under",
          "kind": "boilerplate",
          "text": "month(s) under",
          "export": { "verbatim": true },
          "presentation": { "group": "row1" }
        },
        {
          "id": "section_rule",
          "kind": "text",
          "label": "section / rule",
          "required": true,
          "helpText": "The enabling provision — one of the sections/rules cited in the form header.",
          "validation": {
            "minLength": 1,
            "message": "Cite the enabling section or rule."
          },
          "autofill": {
            "strategy": "derived",
            "derivation": "Suggest the section/rule from the act or step whose deadline is being extended.",
            "confidence": "low"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "request_in_connection",
          "kind": "boilerplate",
          "text": "in connection with",
          "export": { "verbatim": true },
          "presentation": { "group": "row1" }
        },
        {
          "id": "my_our",
          "kind": "strikeoutChoice",
          "label": "my / our",
          "options": [
            { "value": "my", "label": "my" },
            { "value": "our", "label": "our" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "application_patent",
          "kind": "strikeoutChoice",
          "label": "application / Patent",
          "options": [
            { "value": "application", "label": "application" },
            { "value": "patent", "label": "Patent" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "request_no",
          "kind": "boilerplate",
          "text": "No",
          "export": { "verbatim": true },
          "presentation": { "group": "row1" }
        },
        {
          "id": "application_patent_number",
          "kind": "text",
          "label": "Application / Patent No.",
          "required": true,
          "validation": {
            "pattern": "^[A-Za-z0-9/-]{3,20}$",
            "patternMessage": "Enter the application or patent number."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form1", "key": "application.number" },
              { "sourceType": "patent_certificate", "key": "patent.number" }
            ],
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "request_reasons_intro",
          "kind": "boilerplate",
          "text": "The reasons for making the request are as follows:-",
          "export": { "verbatim": true },
          "presentation": { "group": "reasons" }
        },
        {
          "id": "reasons",
          "kind": "textarea",
          "label": "Reasons for making the request",
          "required": true,
          "validation": {
            "minLength": 1,
            "message": "State the reasons for the request."
          },
          "presentation": { "group": "reasons", "multiline": true }
        },
        {
          "id": "statement_date",
          "kind": "date",
          "label": "Dated this __ day of __ 20__",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Default to the preparation / signing date; editable.",
            "confidence": "high"
          }
        }
      ]
    },

    {
      "id": "signature",
      "title": "2. To be signed by the applicant or his authorized registered patent agent",
      "fields": [
        { "id": "signature", "kind": "signature", "label": "Signature", "required": true }
      ]
    },

    {
      "id": "signatory",
      "title": "3. Name of the natural person who has signed",
      "fields": [
        {
          "id": "signatory_name",
          "kind": "text",
          "label": "Name of the natural person who has signed",
          "required": true,
          "validation": {
            "minLength": 2,
            "message": "Enter the full name of the natural person who signed."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form26_authorisation", "key": "agent.name" },
              { "sourceType": "form1", "key": "signatory.name" }
            ],
            "confidence": "medium"
          }
        }
      ]
    },

    {
      "id": "addressee",
      "title": "To",
      "fields": [
        {
          "id": "addressee_boilerplate",
          "kind": "boilerplate",
          "text": "To\nThe Controller of Patents,\nThe Patent Office,\nat",
          "export": { "verbatim": true },
          "presentation": { "group": "addressee" }
        },
        {
          "id": "patent_office",
          "kind": "dropdown",
          "label": "at (Patent Office)",
          "format": "patentOffice",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "delhi", "label": "Delhi" },
            { "value": "mumbai", "label": "Mumbai" },
            { "value": "chennai", "label": "Chennai" },
            { "value": "kolkata", "label": "Kolkata" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Jurisdictional patent office based on the applicant's address or the office recorded on Form 1.",
            "confidence": "medium"
          },
          "presentation": { "group": "addressee", "multiline": false }
        }
      ]
    }
  ],

  "notes": [
    "Note. - For fee: See First Schedule.",
    "Note. - Strike out whichever is not applicable.",
    "The enabling section/rule should be one of the provisions cited in the form header; it may drive the fee and the maximum permissible extension."
  ],

  "metadata": {
    "sourcePdf": "docs/Form_4.PDF",
    "transcribedFrom": "docs/specifications/form_04.md",
    "status": "draft",
    "authoredFrom": "docs/specifications/patterns/patterns.json",
    "printedHeader": {
      "formTitle": "FORM 4",
      "statute": "THE PATENTS ACT, 1970 (39 of 1970) and THE PATENTS RULES, 2003",
      "subject": "REQUEST FOR EXTENSION OF TIME OR CONDONATION OF DELAY",
      "citation": "(See sections 53(2) and 142(4) and rules 12(5), 13(6), 24B(6), 24C(11), 80(1A), 130, 131(2) and 138)"
    }
  }
}
