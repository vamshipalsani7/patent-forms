{
  "schemaVersion": "1.0",
  "formId": "form_25",
  "formNumber": "25",
  "officialName": "Request for Permission for Making Patent Application Outside India",
  "purpose": "Request the Controller's permission to file a patent application outside India for the same or substantially the same invention, under Section 39.",
  "legalReference": {
    "act": ["THE PATENTS ACT, 1970 (39 of 1970)", "Section 39"],
    "rules": ["THE PATENTS RULES, 2003", "Rule 71(1)"]
  },
  "pageCount": 1,
  "fee": { "model": "first_schedule", "note": "For fee: See First Schedule." },
  "layout": {
    "columns": 2,
    "notes": "Two-column form: left column carries the numbered instructions (1-4); right column carries the running request with inline blanks and superscript markers. The first clause has an OR branch: an India application already exists, or a brief description of the invention is attached instead."
  },

  "sections": [
    {
      "id": "invention",
      "title": "Title of the Invention and Existing India Application",
      "description": "Pre-printed: 'I am/We are in possession of an invention for ...... I/We have made an application for the grant of a patent for the said invention, its number being No ...... of ...... Dated ...... OR I/we hereby attach the brief description of the invention.'",
      "fields": [
        {
          "id": "i_am_we_are",
          "kind": "strikeoutChoice",
          "label": "I am / We are",
          "required": true,
          "options": [
            { "value": "i_am", "label": "I am" },
            { "value": "we_are", "label": "We are" }
          ],
          "export": { "strikeoutUnselected": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Choose 'I am' for a single applicant, 'We are' for multiple.",
            "confidence": "high"
          },
          "presentation": { "group": "title", "multiline": false }
        },
        {
          "id": "clause_possession",
          "kind": "boilerplate",
          "text": "in possession of an invention for",
          "export": { "verbatim": true },
          "presentation": { "group": "title" }
        },
        {
          "id": "invention_title",
          "kind": "textarea",
          "label": "Title of the invention",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the title of the invention." },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form2_specification", "key": "invention.title" },
              { "sourceType": "form1", "key": "invention.title" }
            ],
            "confidence": "high"
          },
          "presentation": { "group": "title", "multiline": true }
        },
        {
          "id": "existing_application_branch",
          "kind": "radio",
          "label": "Existing India application (choose one)",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "application_made", "label": "I/We have made an application for the grant of a patent for the said invention" },
            { "value": "description_attached", "label": "I/we hereby attach the brief description of the invention" }
          ]
        },
        {
          "id": "india_application_number",
          "kind": "text",
          "label": "India application number",
          "format": "applicationNumber",
          "required": false,
          "requiredWhen": { "field": "invention.existing_application_branch", "op": "equals", "value": "application_made" },
          "visibleWhen": { "field": "invention.existing_application_branch", "op": "equals", "value": "application_made" },
          "validation": {
            "pattern": "^([0-9]{11,12}|[0-9]{1,6}/[A-Za-z]{2,5}/[0-9]{4})$",
            "patternMessage": "Expected an IPO application number, e.g. 202211012345 or 1234/DEL/2015."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "application.number" }],
            "confidence": "high"
          }
        },
        {
          "id": "india_application_date",
          "kind": "date",
          "label": "Dated (of the India application)",
          "required": false,
          "requiredWhen": { "field": "invention.existing_application_branch", "op": "equals", "value": "application_made" },
          "visibleWhen": { "field": "invention.existing_application_branch", "op": "equals", "value": "application_made" },
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "application.filingDate" }],
            "confidence": "high"
          }
        },
        {
          "id": "brief_description",
          "kind": "textarea",
          "label": "Brief description of the invention",
          "required": false,
          "requiredWhen": { "field": "invention.existing_application_branch", "op": "equals", "value": "description_attached" },
          "visibleWhen": { "field": "invention.existing_application_branch", "op": "equals", "value": "description_attached" },
          "helpText": "Attached where no India application has yet been made.",
          "validation": { "minLength": 1, "message": "Provide the brief description of the invention." }
        }
      ]
    },

    {
      "id": "foreign_filing",
      "title": "Intended Foreign Filing",
      "description": "Pre-printed: 'I/We intend to make application(s) alone/jointly with ...... for the same/substantially same invention for patent in the following country/countries/convention countries, namely:- ......'",
      "fields": [
        {
          "id": "clause_intend",
          "kind": "boilerplate",
          "text": "I/We intend to make application(s)",
          "export": { "verbatim": true },
          "presentation": { "group": "ff" }
        },
        {
          "id": "alone_jointly",
          "kind": "strikeoutChoice",
          "label": "alone / jointly with",
          "required": true,
          "options": [
            { "value": "alone", "label": "alone" },
            { "value": "jointly", "label": "jointly with" }
          ],
          "export": { "strikeoutUnselected": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "'alone' for a single applicant; 'jointly with' when co-applicants exist.",
            "confidence": "medium"
          },
          "presentation": { "group": "ff", "multiline": false }
        },
        {
          "id": "joint_persons",
          "kind": "textarea",
          "label": "Name and address of the joint person(s)",
          "required": false,
          "requiredWhen": { "field": "foreign_filing.alone_jointly", "op": "equals", "value": "jointly" },
          "visibleWhen": { "field": "foreign_filing.alone_jointly", "op": "equals", "value": "jointly" },
          "helpText": "Instruction 2: name and address of the person(s) with whom the application will be made jointly.",
          "validation": { "minLength": 1, "message": "Enter the joint person(s) name and address." },
          "presentation": { "group": "ff", "multiline": true }
        },
        {
          "id": "clause_for_the",
          "kind": "boilerplate",
          "text": "for the",
          "export": { "verbatim": true },
          "presentation": { "group": "ff" }
        },
        {
          "id": "same_substantially",
          "kind": "strikeoutChoice",
          "label": "same / substantially same",
          "required": true,
          "options": [
            { "value": "same", "label": "same" },
            { "value": "substantially", "label": "substantially same" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "ff", "multiline": false }
        },
        {
          "id": "clause_invention_in",
          "kind": "boilerplate",
          "text": "invention for patent in the following",
          "export": { "verbatim": true },
          "presentation": { "group": "ff" }
        },
        {
          "id": "country_scope",
          "kind": "strikeoutChoice",
          "label": "country / countries / convention countries",
          "required": true,
          "options": [
            { "value": "country", "label": "country" },
            { "value": "countries", "label": "countries" },
            { "value": "convention_countries", "label": "convention countries" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "ff", "multiline": false }
        },
        {
          "id": "clause_namely",
          "kind": "boilerplate",
          "text": ", namely:-",
          "export": { "verbatim": true },
          "presentation": { "group": "ff" }
        },
        {
          "id": "country",
          "kind": "text",
          "label": "Country for intended filing",
          "format": "country",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Country" },
          "validation": { "minLength": 2, "message": "Name at least one country." }
        }
      ]
    },

    {
      "id": "assignment",
      "title": "Assignment Declaration",
      "description": "Pre-printed: 'I/We declare that the rights in the application(s) has/have been assigned to ......'. Left blank (and struck out) where the rights have not been assigned.",
      "fields": [
        {
          "id": "clause_declare_rights",
          "kind": "boilerplate",
          "text": "I/We declare that the rights in the application(s)",
          "export": { "verbatim": true },
          "presentation": { "group": "assign" }
        },
        {
          "id": "has_have",
          "kind": "strikeoutChoice",
          "label": "has / have",
          "options": [
            { "value": "has", "label": "has" },
            { "value": "have", "label": "have" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "assign", "multiline": false }
        },
        {
          "id": "clause_assigned_to",
          "kind": "boilerplate",
          "text": "been assigned to",
          "export": { "verbatim": true },
          "presentation": { "group": "assign" }
        },
        {
          "id": "assignee",
          "kind": "textarea",
          "label": "Name and address of the assignee",
          "format": "address",
          "required": false,
          "helpText": "Instruction 3. Leave blank (the line is struck out) if the rights have not been assigned.",
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "assignment_document", "key": "assignee.name" },
              { "sourceType": "assignment_document", "key": "assignee.address" }
            ],
            "confidence": "low"
          },
          "presentation": { "group": "assign", "multiline": true }
        }
      ]
    },

    {
      "id": "request",
      "title": "Request, Reasons and Declaration",
      "fields": [
        {
          "id": "permission_request",
          "kind": "boilerplate",
          "text": "I/We request that I/We may be granted permission to make application(s) for the said invention in the said country/countries.",
          "export": { "verbatim": true }
        },
        {
          "id": "reasons",
          "kind": "textarea",
          "label": "Reasons for making this application",
          "required": true,
          "validation": { "minLength": 1, "message": "State the reasons for the request." }
        },
        {
          "id": "truth_declaration",
          "kind": "boilerplate",
          "text": "The facts and matters stated above are true to the best of my/our knowledge, information and belief.",
          "export": { "verbatim": true }
        },
        {
          "id": "statement_date",
          "kind": "date",
          "label": "Dated this __ day of __ 20__",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Default to the preparation / signing date; editable.",
            "confidence": "high"
          }
        }
      ]
    },

    {
      "id": "signature",
      "title": "To be signed by the applicant(s) or authorised patent agent.",
      "fields": [
        { "id": "signature", "kind": "signature", "label": "Signature", "required": true }
      ]
    },

    {
      "id": "addressee",
      "title": "To",
      "fields": [
        {
          "id": "addressee_boilerplate",
          "kind": "boilerplate",
          "text": "To\nThe Controller of Patents,\nThe Patent Office,\nat",
          "export": { "verbatim": true },
          "presentation": { "group": "addressee" }
        },
        {
          "id": "patent_office",
          "kind": "dropdown",
          "label": "at (Patent Office)",
          "format": "patentOffice",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "delhi", "label": "Delhi" },
            { "value": "mumbai", "label": "Mumbai" },
            { "value": "chennai", "label": "Chennai" },
            { "value": "kolkata", "label": "Kolkata" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Jurisdictional patent office based on the applicant's address or the office recorded on Form 1.",
            "confidence": "medium"
          },
          "presentation": { "group": "addressee", "multiline": false }
        }
      ]
    }
  ],

  "attachments": [
    {
      "id": "brief_description",
      "label": "Brief description of the invention",
      "required": false,
      "note": "Attached where no India application has yet been made (the second branch of the first clause)."
    }
  ],

  "notes": [
    "Note. - Strike out whichever is not applicable (I am/We are, alone/jointly, same/substantially same, country/countries/convention countries, has/have).",
    "Note. - For fee: See First Schedule.",
    "Section 39 requires prior permission (or a six-week wait after an India filing) before filing abroad; foreign filing without it can invalidate the Indian patent. This is a high-stakes compliance step.",
    "The form shows a signature line; the signatory's name is captured via the applicant details rather than a separate printed field."
  ],

  "metadata": {
    "sourcePdf": "docs/Form_25.PDF",
    "transcribedFrom": "docs/specifications/form_25.md",
    "status": "draft",
    "authoredFrom": "docs/specifications/patterns/patterns.json",
    "printedHeader": {
      "formTitle": "FORM 25",
      "statute": "THE PATENTS ACT, 1970 (39 of 1970) and THE PATENTS RULES, 2003",
      "subject": "REQUEST FOR PERMISSION FOR MAKING PATENT APPLICATION OUTSIDE INDIA",
      "citation": "(See section 39 and rule 71(1))"
    }
  }
}
