{
  "schemaVersion": "1.0",
  "formId": "form_07",
  "formNumber": "7",
  "officialName": "Notice of Opposition",
  "purpose": "Give notice of post-grant opposition to a granted patent, stating the opponent's particulars and the grounds of opposition.",
  "legalReference": {
    "act": ["THE PATENTS ACT, 1970 (39 of 1970)", "Section 25(2)"],
    "rules": ["THE PATENTS RULES, 2003", "Rule 55A"]
  },
  "pageCount": 1,
  "fee": { "model": "first_schedule", "note": "For fee: See First Schedule." },
  "layout": {
    "columns": 2,
    "notes": "Two-column form: left column carries the numbered instructions (1-5); right column carries the running notice with inline blanks and superscript markers. Form 7 prints no 'Dated this...' line; the signing date is not a printed field."
  },

  "sections": [
    {
      "id": "opponent",
      "title": "Opponent Particulars",
      "description": "Instruction 1: state the names, address and nationality of the opponent(s). The opponent is usually a third party, so autofill from the patentee's documents does not apply to their identity.",
      "fields": [
        {
          "id": "iwe",
          "kind": "strikeoutChoice",
          "label": "I/We",
          "required": true,
          "options": [
            { "value": "i", "label": "I" },
            { "value": "we", "label": "We" }
          ],
          "export": { "strikeoutUnselected": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Choose 'I' for a single opponent, 'We' for multiple.",
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "opponent_particulars",
          "kind": "textarea",
          "label": "Names, address and nationality of the opponent(s)",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Opponent" },
          "helpText": "Full name(s) (family/principal name first), complete address incl postal index no./code and state, and nationality.",
          "validation": { "minLength": 2, "message": "Enter the opponent's name, address and nationality." },
          "presentation": { "group": "row1", "multiline": true }
        }
      ]
    },

    {
      "id": "patent",
      "title": "Patent Being Opposed",
      "description": "Pre-printed: 'hereby give notice of opposition to patent No. ...... granted on application No. ...... dated ...... published on dated ...... made by ...... on the grounds:'",
      "fields": [
        {
          "id": "clause_intro",
          "kind": "boilerplate",
          "text": "hereby give notice of opposition to patent No.",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "patent_number",
          "kind": "text",
          "label": "Patent No.",
          "format": "patentNumber",
          "required": true,
          "validation": {
            "pattern": "^[A-Za-z0-9/-]{1,20}$",
            "patternMessage": "Enter the patent number."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patent.number" }],
            "confidence": "medium"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_granted_on",
          "kind": "boilerplate",
          "text": "granted on application No.",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "application_number",
          "kind": "text",
          "label": "Application No.",
          "format": "applicationNumber",
          "required": true,
          "validation": {
            "pattern": "^([0-9]{11,12}|[0-9]{1,6}/[A-Za-z]{2,5}/[0-9]{4})$",
            "patternMessage": "Expected an IPO application number, e.g. 202211012345 or 1234/DEL/2015."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "application.number" }],
            "confidence": "medium"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_dated",
          "kind": "boilerplate",
          "text": "dated",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "application_date",
          "kind": "date",
          "label": "Application dated",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "application.filingDate" }],
            "confidence": "medium"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_granted_date",
          "kind": "boilerplate",
          "text": "granted on dated",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "grant_date",
          "kind": "date",
          "label": "Granted on (date)",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patent.grantDate" }],
            "confidence": "medium"
          },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_published_on",
          "kind": "boilerplate",
          "text": "published on dated",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "published_date",
          "kind": "date",
          "label": "Published on (date)",
          "required": true,
          "helpText": "Date of publication of the application under section 11A (from the patent gazette / publication record).",
          "validation": { "notFuture": true },
          "presentation": { "group": "patent", "multiline": false }
        },
        {
          "id": "clause_made_by",
          "kind": "boilerplate",
          "text": "made by",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        },
        {
          "id": "made_by",
          "kind": "textarea",
          "label": "Made by (patentee)",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the patentee." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "patent_certificate", "key": "patentee.name" }],
            "confidence": "medium"
          },
          "presentation": { "group": "patent", "multiline": true }
        },
        {
          "id": "clause_grounds",
          "kind": "boilerplate",
          "text": "on the grounds:",
          "export": { "verbatim": true },
          "presentation": { "group": "patent" }
        }
      ]
    },

    {
      "id": "grounds",
      "title": "Grounds of Opposition",
      "description": "Instruction 2: state the grounds one after another.",
      "fields": [
        {
          "id": "ground",
          "kind": "textarea",
          "label": "Ground of opposition",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Ground" },
          "validation": { "minLength": 1, "message": "State at least one ground of opposition." }
        }
      ]
    },

    {
      "id": "address_for_service",
      "title": "Address for Service in India",
      "description": "Instruction 3: complete address incl postal index number/code and state along with telephone and fax number.",
      "fields": [
        {
          "id": "address_for_service",
          "kind": "textarea",
          "label": "My/Our address for service in India",
          "format": "address",
          "required": true,
          "helpText": "Must be an address in India. Include postal index no./code, state, and telephone and fax number(s).",
          "validation": { "minLength": 2, "message": "Enter an address for service in India." }
        }
      ]
    },

    {
      "id": "signature",
      "title": "To be signed by the opponent or by his authorized registered patent agent.",
      "fields": [
        { "id": "signature", "kind": "signature", "label": "Signature", "required": true }
      ]
    },

    {
      "id": "signatory",
      "title": "Name of the natural person who has signed.",
      "fields": [
        {
          "id": "signatory_name",
          "kind": "text",
          "label": "Name of the natural person who has signed",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the full name of the natural person who signed." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form26_authorisation", "key": "agent.name" }],
            "confidence": "low"
          }
        }
      ]
    },

    {
      "id": "addressee",
      "title": "To",
      "fields": [
        {
          "id": "addressee_boilerplate",
          "kind": "boilerplate",
          "text": "To\nThe Controller of Patents,\nThe Patent Office,\nat",
          "export": { "verbatim": true },
          "presentation": { "group": "addressee" }
        },
        {
          "id": "patent_office",
          "kind": "dropdown",
          "label": "at (Patent Office)",
          "format": "patentOffice",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "delhi", "label": "Delhi" },
            { "value": "mumbai", "label": "Mumbai" },
            { "value": "chennai", "label": "Chennai" },
            { "value": "kolkata", "label": "Kolkata" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Jurisdictional patent office based on the opponent's address or the office where the patent was granted.",
            "confidence": "low"
          },
          "presentation": { "group": "addressee", "multiline": false }
        }
      ]
    }
  ],

  "attachments": [
    {
      "id": "written_statement",
      "label": "Written statement and evidence in support of the opposition",
      "required": false,
      "note": "Typically accompanies the notice per the post-grant opposition procedure, though not enumerated as a field on the form face."
    }
  ],

  "notes": [
    "Note. - For fee: See First Schedule.",
    "Note. - Strike out whichever is not applicable.",
    "Form 7 is post-grant opposition (s.25(2)); distinct from Form 7A, the pre-grant representation (s.25(1), rule 55).",
    "The opponent is typically a third party; autofill from the patentee's uploaded documents is limited to the opposed patent's particulars, not the opponent's identity."
  ],

  "metadata": {
    "sourcePdf": "docs/Form_7.PDF",
    "transcribedFrom": "docs/specifications/form_07.md",
    "status": "draft",
    "authoredFrom": "docs/specifications/patterns/patterns.json",
    "printedHeader": {
      "formTitle": "FORM 7",
      "statute": "THE PATENTS ACT, 1970 (39 of 1970) and THE PATENTS RULES, 2003",
      "subject": "NOTICE OF OPPOSITION",
      "citation": "(See section 25(2) and rule 55A)"
    }
  }
}
