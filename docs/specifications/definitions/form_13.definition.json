{
  "schemaVersion": "1.0",
  "formId": "form_13",
  "formNumber": "13",
  "officialName": "Application for Amendment of the Application for Patent / Complete Specification / Any Document Related Thereto",
  "purpose": "Request leave to amend the patent application, the complete specification, or any document related thereto, with the proposed amendments highlighted in an annexed copy, and declaring that no infringement/revocation action is pending and that the stated facts are true.",
  "legalReference": {
    "act": ["THE PATENTS ACT, 1970 (39 of 1970)", "Section 57"],
    "rules": ["THE PATENTS RULES, 2003", "Rule 81, sub-rule (1)"]
  },
  "pageCount": 1,
  "fee": { "model": "first_schedule", "note": "For fee: See First Schedule." },
  "layout": {
    "columns": 2,
    "notes": "Two-column table with three numbered rows. Row 1's right column is one running paragraph: the amendment request, the reasons, and two mandatory declarations. Fields sharing a presentation.group belong on the same printed line."
  },

  "sections": [
    {
      "id": "amendment_request",
      "title": "1. Name of the applicant(s).",
      "description": "Row 1 right column: 'I/We ... request leave to amend the application / any document related thereto / complete specification, application for patent No. ... dated ..., as highlighted in the copy hereto annexed. My/Our reason for making this request are as follows:- ...' followed by the two mandatory declarations and the date.",
      "fields": [
        {
          "id": "iwe",
          "kind": "strikeoutChoice",
          "label": "I/We",
          "required": true,
          "options": [
            { "value": "i", "label": "I" },
            { "value": "we", "label": "We" }
          ],
          "export": { "strikeoutUnselected": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Choose 'I' for a single applicant, 'We' for multiple, from the applicant count in uploaded documents.",
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "applicant_names",
          "kind": "textarea",
          "label": "Name of the applicant(s)",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Applicant" },
          "validation": { "minLength": 2, "message": "Enter the applicant's name." },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form1", "key": "applicant.name" },
              { "sourceType": "form2_specification", "key": "applicant.name" },
              { "sourceType": "patent_certificate", "key": "applicant.name" }
            ],
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": true }
        },
        {
          "id": "amend_intro",
          "kind": "boilerplate",
          "text": "request leave to amend the",
          "export": { "verbatim": true },
          "presentation": { "group": "row1" }
        },
        {
          "id": "amendment_subject",
          "kind": "strikeoutChoice",
          "label": "application / any document related thereto / complete specification",
          "description": "The item being amended; determines what the annexed marked-up copy contains.",
          "required": true,
          "options": [
            { "value": "application", "label": "application" },
            { "value": "document", "label": "any document related thereto" },
            { "value": "complete_specification", "label": "complete specification" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "amend_application_no",
          "kind": "boilerplate",
          "text": "application for patent No.",
          "export": { "verbatim": true },
          "presentation": { "group": "row1" }
        },
        {
          "id": "application_number",
          "kind": "text",
          "label": "Application for patent No.",
          "required": true,
          "validation": {
            "pattern": "^[A-Za-z0-9/-]{3,20}$",
            "patternMessage": "Enter the application (or patent) number."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form1", "key": "application.number" },
              { "sourceType": "patent_certificate", "key": "patent.number" }
            ],
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "amend_dated",
          "kind": "boilerplate",
          "text": "dated",
          "export": { "verbatim": true },
          "presentation": { "group": "row1" }
        },
        {
          "id": "application_date",
          "kind": "date",
          "label": "Dated (of the application/patent)",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form1", "key": "application.filingDate" },
              { "sourceType": "patent_certificate", "key": "patent.grantDate" }
            ],
            "confidence": "high"
          },
          "presentation": { "group": "row1", "multiline": false }
        },
        {
          "id": "annexed_copy",
          "kind": "boilerplate",
          "text": "as highlighted in the copy hereto annexed.",
          "export": { "verbatim": true },
          "presentation": { "group": "row1" }
        },
        {
          "id": "my_our",
          "kind": "strikeoutChoice",
          "label": "My / Our",
          "options": [
            { "value": "my", "label": "My" },
            { "value": "our", "label": "Our" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "reasons", "multiline": false }
        },
        {
          "id": "reasons_intro",
          "kind": "boilerplate",
          "text": "reason for making this request are as follows:-",
          "export": { "verbatim": true },
          "presentation": { "group": "reasons" }
        },
        {
          "id": "reasons",
          "kind": "textarea",
          "label": "Reason(s) for making this request",
          "required": true,
          "validation": { "minLength": 1, "message": "State the reasons for the request." },
          "presentation": { "group": "reasons", "multiline": true }
        },
        {
          "id": "declaration_no_action",
          "kind": "boilerplate",
          "text": "I/We declare that no action for infringement or for the revocation of the patent in question is pending before Appellate Board or a Court.",
          "export": { "verbatim": true }
        },
        {
          "id": "declaration_truth",
          "kind": "boilerplate",
          "text": "I/We declare that the facts and matters stated herein are true to the best of my/our knowledge information and belief.",
          "export": { "verbatim": true }
        },
        {
          "id": "statement_date",
          "kind": "date",
          "label": "Dated this __ day of __ 20__",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "derived",
            "derivation": "Default to the preparation / signing date; editable.",
            "confidence": "high"
          }
        }
      ]
    },

    {
      "id": "signature",
      "title": "2. To be signed by the applicant(s) or patentee(s) or by his authorized registered patent agent",
      "fields": [
        { "id": "signature", "kind": "signature", "label": "Signature", "required": true }
      ]
    },

    {
      "id": "signatory",
      "title": "3. Name of the natural person who has signed",
      "fields": [
        {
          "id": "signatory_name",
          "kind": "text",
          "label": "Name of the natural person who has signed",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the full name of the natural person who signed." },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form26_authorisation", "key": "agent.name" },
              { "sourceType": "form1", "key": "signatory.name" }
            ],
            "confidence": "medium"
          }
        }
      ]
    },

    {
      "id": "addressee",
      "title": "To",
      "fields": [
        {
          "id": "addressee_boilerplate",
          "kind": "boilerplate",
          "text": "To\nThe Controller of Patents,\nThe Patent Office,\nat",
          "export": { "verbatim": true },
          "presentation": { "group": "addressee" }
        },
        {
          "id": "patent_office",
          "kind": "dropdown",
          "label": "at (Patent Office)",
          "format": "patentOffice",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "delhi", "label": "Delhi" },
            { "value": "mumbai", "label": "Mumbai" },
            { "value": "chennai", "label": "Chennai" },
            { "value": "kolkata", "label": "Kolkata" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Jurisdictional patent office based on the applicant's address or the office recorded on Form 1.",
            "confidence": "medium"
          },
          "presentation": { "group": "addressee", "multiline": false }
        }
      ]
    }
  ],

  "attachments": [
    {
      "id": "marked_up_copy",
      "label": "Copy of the amended application / specification / document with the proposed amendments highlighted",
      "required": true,
      "note": "The proposed amendments must be shown 'as highlighted in the copy hereto annexed'."
    }
  ],

  "notes": [
    "Note. - For fee: See First Schedule.",
    "Note. - Strike out whichever is not applicable.",
    "Two mandatory declarations: (a) no infringement/revocation action is pending; (b) the facts stated are true.",
    "The proposed amendments must be annexed as a highlighted (marked-up) copy.",
    "Distinct from Form 10, which amends a granted patent's grantee name (s.44); Form 13 amends the application/specification/documents (s.57)."
  ],

  "metadata": {
    "sourcePdf": "docs/Form_13.PDF",
    "transcribedFrom": "docs/specifications/form_13.md",
    "status": "draft",
    "authoredFrom": "docs/specifications/patterns/patterns.json",
    "printedHeader": {
      "formTitle": "FORM 13",
      "statute": "THE PATENTS ACT, 1970 (39 of 1970) and THE PATENTS RULES, 2003",
      "subject": "APPLICATION FOR AMENDMENT OF THE APPLICATION FOR PATENT / COMPLETE SPECIFICATION / ANY DOCUMENT RELATED THERETO",
      "citation": "(See section 57 and rule 81(1))"
    }
  }
}
