{
  "schemaVersion": "1.0",
  "formId": "form_05",
  "formNumber": "5",
  "officialName": "Declaration as to Inventorship",
  "purpose": "Declaration by the applicant(s) identifying the true and first inventor(s) of the invention disclosed in the complete specification, with a convention-country assignment declaration and a statement of assent by any additional inventor(s) not named in the application form.",
  "legalReference": {
    "act": ["THE PATENTS ACT, 1970 (39 of 1970)", "Section 10(6)"],
    "rules": ["THE PATENTS RULES, 2003", "Rule 13(6)"]
  },
  "pageCount": 1,
  "fee": { "model": "none", "note": "No fee is printed on the face of Form 5." },
  "layout": {
    "columns": 1,
    "notes": "Single-column, four numbered sections, each with its own dated signature line. Sections 3 and 4 are optional pre-printed declarations completed only when applicable; their inputs are optional rather than gated by an invented toggle."
  },

  "sections": [
    {
      "id": "applicant_declaration",
      "title": "1. NAME OF APPLICANT(S)",
      "description": "Pre-printed: '... hereby declare that the true and first inventor(s) of the invention disclosed in the complete specification filed in pursuance of my/our application numbered ... dated ... is/are'",
      "fields": [
        {
          "id": "applicant_names",
          "kind": "textarea",
          "label": "Name of applicant(s)",
          "required": true,
          "repeatable": { "min": 1, "max": null, "itemLabel": "Applicant" },
          "helpText": "Name in full, family name in the beginning.",
          "validation": {
            "minLength": 2,
            "message": "Enter the applicant's full name."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form1", "key": "applicant.name" },
              { "sourceType": "form2_specification", "key": "applicant.name" }
            ],
            "confidence": "high"
          },
          "presentation": { "group": "declare", "multiline": true }
        },
        {
          "id": "declare_intro",
          "kind": "boilerplate",
          "text": "hereby declare that the true and first inventor(s) of the invention disclosed in the complete specification filed in pursuance of",
          "export": { "verbatim": true },
          "presentation": { "group": "declare" }
        },
        {
          "id": "my_our",
          "kind": "strikeoutChoice",
          "label": "my / our",
          "options": [
            { "value": "my", "label": "my" },
            { "value": "our", "label": "our" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "declare", "multiline": false }
        },
        {
          "id": "declare_numbered",
          "kind": "boilerplate",
          "text": "application numbered",
          "export": { "verbatim": true },
          "presentation": { "group": "declare" }
        },
        {
          "id": "application_number",
          "kind": "text",
          "label": "Application number",
          "format": "applicationNumber",
          "required": true,
          "validation": {
            "pattern": "^([0-9]{11,12}|[0-9]{1,6}/[A-Za-z]{2,5}/[0-9]{4})$",
            "patternMessage": "Expected an IPO application number, e.g. 202211012345 or 1234/DEL/2015."
          },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "application.number" }],
            "confidence": "high"
          },
          "presentation": { "group": "declare", "multiline": false }
        },
        {
          "id": "declare_dated",
          "kind": "boilerplate",
          "text": "dated",
          "export": { "verbatim": true },
          "presentation": { "group": "declare" }
        },
        {
          "id": "application_date",
          "kind": "date",
          "label": "Date of the application",
          "required": true,
          "validation": { "notFuture": true },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form1", "key": "application.filingDate" }],
            "confidence": "high"
          },
          "presentation": { "group": "declare", "multiline": false }
        },
        {
          "id": "is_are",
          "kind": "strikeoutChoice",
          "label": "is / are",
          "options": [
            { "value": "is", "label": "is" },
            { "value": "are", "label": "are" }
          ],
          "export": { "strikeoutUnselected": true },
          "presentation": { "group": "declare", "multiline": false }
        }
      ]
    },

    {
      "id": "inventors",
      "title": "2. INVENTOR(S)",
      "description": "Inventor particulars, repeated per inventor, followed by the applicant's dated signature of this declaration.",
      "fields": [
        {
          "id": "inventor",
          "kind": "group",
          "label": "Inventor",
          "repeatable": { "min": 1, "max": null, "itemLabel": "Inventor" },
          "fields": [
            {
              "id": "name",
              "kind": "text",
              "label": "(a) Name",
              "required": true,
              "helpText": "Name in full, family name in the beginning.",
              "validation": {
                "minLength": 2,
                "message": "Enter the inventor's full name."
              },
              "autofill": {
                "strategy": "direct",
                "sources": [
                  { "sourceType": "form1", "key": "inventor.name" },
                  { "sourceType": "form2_specification", "key": "inventor.name" }
                ],
                "confidence": "high"
              }
            },
            {
              "id": "nationality",
              "kind": "text",
              "label": "(b) Nationality",
              "format": "country",
              "required": true,
              "validation": {
                "minLength": 2,
                "message": "Enter the inventor's nationality."
              },
              "autofill": {
                "strategy": "direct",
                "sources": [
                  { "sourceType": "form1", "key": "inventor.nationality" },
                  { "sourceType": "form2_specification", "key": "inventor.nationality" }
                ],
                "confidence": "medium"
              }
            },
            {
              "id": "address",
              "kind": "textarea",
              "label": "(c) Address",
              "format": "address",
              "required": true,
              "helpText": "Complete address incl postal index no./code, state and country.",
              "validation": {
                "minLength": 2,
                "message": "Enter the inventor's complete address."
              },
              "autofill": {
                "strategy": "direct",
                "sources": [
                  { "sourceType": "form1", "key": "inventor.address" },
                  { "sourceType": "form2_specification", "key": "inventor.address" }
                ],
                "confidence": "medium"
              }
            }
          ]
        },
        {
          "id": "applicant_signature",
          "kind": "signatureBlock",
          "label": "Signature (applicant's declaration)",
          "fields": [
            {
              "id": "date",
              "kind": "date",
              "label": "Dated this __ day of __ 20__",
              "required": true,
              "validation": { "notFuture": true },
              "autofill": {
                "strategy": "derived",
                "derivation": "Default to the preparation / signing date; editable.",
                "confidence": "high"
              }
            },
            { "id": "signature", "kind": "signature", "label": "Signature", "required": true },
            {
              "id": "name",
              "kind": "text",
              "label": "Name of the signatory",
              "required": true,
              "validation": {
                "minLength": 2,
                "message": "Enter the full name of the signatory."
              },
              "autofill": {
                "strategy": "direct",
                "sources": [
                  { "sourceType": "form26_authorisation", "key": "agent.name" },
                  { "sourceType": "form1", "key": "signatory.name" }
                ],
                "confidence": "medium"
              }
            }
          ]
        }
      ]
    },

    {
      "id": "convention_declaration",
      "title": "3. DECLARATION TO BE GIVEN WHEN THE APPLICATION IN INDIA IS FILED BY THE APPLICANT(S) IN THE CONVENTION COUNTRY:-",
      "description": "Optional pre-printed declaration; complete only when the India application is filed by a convention-country applicant.",
      "fields": [
        {
          "id": "convention_boilerplate",
          "kind": "boilerplate",
          "text": "We the applicant(s) in the convention country hereby declare that our right to apply for a patent in India is by way of assignment from the true and first inventor(s).",
          "export": { "verbatim": true }
        },
        {
          "id": "convention_signature",
          "kind": "signatureBlock",
          "label": "Signature (convention-country applicant)",
          "fields": [
            {
              "id": "date",
              "kind": "date",
              "label": "Dated this __ day of __ 20__",
              "required": false,
              "validation": { "notFuture": true }
            },
            { "id": "signature", "kind": "signature", "label": "Signature", "required": false },
            {
              "id": "name",
              "kind": "text",
              "label": "Name of the signatory",
              "required": false,
              "autofill": {
                "strategy": "direct",
                "sources": [
                  { "sourceType": "form26_authorisation", "key": "agent.name" },
                  { "sourceType": "form1", "key": "signatory.name" }
                ],
                "confidence": "low"
              }
            }
          ]
        }
      ]
    },

    {
      "id": "additional_inventor_statement",
      "title": "4. STATEMENT (to be signed by the additional inventor(s) not mentioned in the application form)",
      "description": "Optional pre-printed statement of assent, signed by each additional inventor not named on the application form.",
      "fields": [
        {
          "id": "statement_boilerplate",
          "kind": "boilerplate",
          "text": "I/We assent to the invention referred to in the above declaration, being included in the complete specification filed in pursuance of the stated application.",
          "export": { "verbatim": true }
        },
        {
          "id": "additional_inventor_signature",
          "kind": "signatureBlock",
          "label": "Signature of the additional inventor(s)",
          "repeatable": { "min": 0, "max": null, "itemLabel": "Additional inventor" },
          "fields": [
            {
              "id": "date",
              "kind": "date",
              "label": "Dated this __ day of __ 20__",
              "required": false,
              "validation": { "notFuture": true }
            },
            { "id": "signature", "kind": "signature", "label": "Signature", "required": false },
            {
              "id": "name",
              "kind": "text",
              "label": "Name of the additional inventor",
              "required": false,
              "autofill": {
                "strategy": "direct",
                "sources": [
                  { "sourceType": "form1", "key": "inventor.name" },
                  { "sourceType": "form2_specification", "key": "inventor.name" }
                ],
                "confidence": "low"
              }
            }
          ]
        }
      ]
    },

    {
      "id": "addressee",
      "title": "To",
      "fields": [
        {
          "id": "addressee_boilerplate",
          "kind": "boilerplate",
          "text": "To,\nThe Controller of Patents,\nThe Patent Office,\nat",
          "export": { "verbatim": true },
          "presentation": { "group": "addressee" }
        },
        {
          "id": "patent_office",
          "kind": "dropdown",
          "label": "at (Patent Office)",
          "format": "patentOffice",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "delhi", "label": "Delhi" },
            { "value": "mumbai", "label": "Mumbai" },
            { "value": "chennai", "label": "Chennai" },
            { "value": "kolkata", "label": "Kolkata" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Jurisdictional patent office based on the applicant's address or the office recorded on Form 1.",
            "confidence": "medium"
          },
          "presentation": { "group": "addressee", "multiline": false }
        }
      ]
    }
  ],

  "notes": [
    "Note. - Repeat boxes in case of more than one entry.",
    "Note. - To be signed by the applicant(s) or by authorized registered patent agent otherwise where mentioned.",
    "Note. - Name of the inventor and applicant should be given in full, family name in the beginning.",
    "Note. - Complete address of the inventor should be given stating the postal index no./code, state and country.",
    "Note. - Strike out the column which is/are not applicable.",
    "Sections 3 and 4 are optional pre-printed declarations, completed only when applicable (convention-country filing; additional inventors)."
  ],

  "metadata": {
    "sourcePdf": "docs/Form_5.PDF",
    "transcribedFrom": "docs/specifications/form_05.md",
    "status": "draft",
    "authoredFrom": "docs/specifications/patterns/patterns.json",
    "printedHeader": {
      "formTitle": "FORM 5",
      "statute": "THE PATENTS ACT, 1970 (39 of 1970) and THE PATENTS RULES, 2003",
      "subject": "DECLARATION AS TO INVENTORSHIP",
      "citation": "(See section 10(6) and rule 13(6))"
    }
  }
}
