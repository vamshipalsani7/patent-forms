                  "confidence": "low"
                }
              }
            },
            {
              "id": "ipc",
              "label": "IPC (as classified in the convention country)",
              "cell": { "kind": "text", "format": "ipc" }
            }
          ]
        }
      ]
    },

    {
      "id": "pct_particulars",
      "title": "9. IN CASE OF PCT NATIONAL PHASE APPLICATION, PARTICULARS OF INTERNATIONAL APPLICATION FILED UNDER PATENT CO-OPERATION TREATY (PCT)",
