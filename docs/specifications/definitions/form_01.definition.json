    {
      "id": "declaration_inventors",
      "title": "12. DECLARATIONS — (i) Declaration by the inventor(s)",
      "fields": [
        {
          "id": "declaration_text",
          "kind": "boilerplate",
          "text": "I/We, the above named inventor(s) is/are the true & first inventor(s) for this Invention and declare that the applicant(s) herein is/are my/our assignee or legal representative.",
          "export": { "verbatim": true }
        },
        {
          "id": "inventor_signature",
          "kind": "signatureBlock",
          "label": "Inventor declaration signature",
          "repeatable": { "min": 1, "max": null, "itemLabel": "Inventor" },
          "fields": [
            {
              "id": "date",
              "kind": "date",
