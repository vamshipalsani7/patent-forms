{
  "schemaVersion": "1.0",
  "formId": "form_01",
  "formNumber": "1",
  "officialName": "Application for Grant of Patent",
  "purpose": "The primary application by which an applicant requests the grant of a patent in India. Captures applicant(s), inventor(s), title, agent, address for service, priority/PCT/divisional/patent-of-addition particulars, statutory declarations, and the list of attachments.",
  "legalReference": {
    "act": ["THE PATENTS ACT, 1970 (39 of 1970)", "Sections 7, 54 and 135"],
    "rules": ["THE PATENTS RULES, 2003", "Rule 20, sub-rule (1)"]
  },
  "pageCount": 4,
  "fee": {
    "model": "first_schedule",
    "note": "For fee: See First Schedule.",
    "dependsOn": ["applicant_category", "claim_count", "page_count"]
  },
  "layout": {
    "columns": 1,
    "notes": "Single-column, sectioned form: a FOR OFFICE USE ONLY header block plus 13 numbered paragraphs (with sub-parts 3A/3B and declaration groups (i)-(iii)). Applicant, inventor, agent and convention entries repeat ('Repeat boxes in case of more than one entry'). Sections 8/9/10/11 and declarations 12(ii) are gated by the Section 2 Type of Application selection."
  },

  "sections": [
    {
      "id": "office_use",
      "title": "FOR OFFICE USE ONLY",
      "officeUseOnly": true,
      "description": "Pre-printed box completed by the Patent Office, not by the applicant. Reproduced on preview but never editable by the applicant.",
      "fields": [
        { "id": "application_no", "kind": "text", "label": "Application No.", "officeUseOnly": true },
        { "id": "filing_date", "kind": "date", "label": "Filing date", "officeUseOnly": true },
        { "id": "fee_paid", "kind": "number", "label": "Amount of Fee paid", "format": "currency", "officeUseOnly": true },
        { "id": "cbr_no", "kind": "text", "label": "CBR No.", "officeUseOnly": true },
        { "id": "office_signature", "kind": "signature", "label": "Signature", "officeUseOnly": true }
      ]
    },

    {
      "id": "applicant_reference",
      "title": "1. APPLICANT'S REFERENCE / IDENTIFICATION NO. (AS ALLOTTED BY OFFICE)",
      "fields": [
        {
          "id": "reference_no",
          "kind": "text",
          "label": "Applicant's reference / identification no.",
          "required": false,
          "helpText": "Office-allotted identifier, where one has already been allotted."
        }
      ]
    },

    {
      "id": "type_of_application",
      "title": "2. TYPE OF APPLICATION [Please tick (✓) at the appropriate category]",
      "description": "Selects the nature of the application. The printed grid permits combinations (e.g. a Convention application that is also Divisional or a Patent of Addition). Selecting Convention / PCT-NP / Divisional / Patent of Addition activates the corresponding particulars in paragraphs 8 / 9 / 10 / 11.",
      "fields": [
        {
          "id": "application_type",
          "kind": "checkboxGroup",
          "label": "Type of application",
          "required": true,
          "selection": "multiple",
          "options": [
            { "value": "ordinary", "label": "Ordinary" },
            { "value": "convention", "label": "Convention" },
            { "value": "pct_np", "label": "PCT-NP (PCT National Phase)" },
            { "value": "pph", "label": "PPH (Patent Prosecution Highway)" },
            { "value": "divisional", "label": "Divisional" },
            { "value": "patent_of_addition", "label": "Patent of Addition" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Infer from uploaded documents: PCT documents suggest PCT-NP; priority/convention documents suggest Convention; a reference to a parent application suggests Divisional; a reference to a main patent suggests Patent of Addition. The user confirms.",
            "confidence": "low"
          }
        }
      ]
    },

    {
      "id": "applicants",
      "title": "3A. APPLICANT(S)",
      "description": "One block per applicant; repeat for more than one entry. The address is a composite sub-block.",
      "fields": [
        {
          "id": "applicant",
          "kind": "group",
          "label": "Applicant",
          "repeatable": { "min": 1, "max": null, "itemLabel": "Applicant" },
          "fields": [
            {
              "id": "name",
              "kind": "text",
              "label": "Name in Full",
              "required": true,
              "helpText": "Name should be given in full, family name in the beginning.",
              "validation": { "minLength": 2, "message": "Enter the applicant's full name." },
              "autofill": {
                "strategy": "direct",
                "sources": [{ "sourceType": "form2_specification", "key": "applicant.name" }],
                "confidence": "high"
              }
            },
            {
              "id": "gender",
              "kind": "radio",
              "label": "Gender (optional, for individuals)",
              "required": false,
              "selection": "single",
              "options": [
                { "value": "male", "label": "Male" },
                { "value": "female", "label": "Female" },
                { "value": "others", "label": "Others" },
                { "value": "not_disclosed", "label": "Prefer not to disclose" }
              ]
            },
            {
              "id": "nationality",
              "kind": "text",
              "label": "Nationality",
              "format": "country",
              "required": true,
              "validation": { "minLength": 2, "message": "Enter the applicant's nationality." },
              "autofill": {
                "strategy": "direct",
                "sources": [{ "sourceType": "form2_specification", "key": "applicant.nationality" }],
                "confidence": "medium"
              }
            },
            {
              "id": "country_of_residence",
              "kind": "text",
              "label": "Country of Residence",
              "format": "country",
              "required": true,
              "validation": { "minLength": 2, "message": "Enter the country of residence." },
              "autofill": {
                "strategy": "direct",
                "sources": [{ "sourceType": "form2_specification", "key": "applicant.country" }],
                "confidence": "medium"
              }
            },
            {
              "id": "age",
              "kind": "number",
              "label": "Age (optional, for natural persons)",
              "required": false,
              "helpText": "In years. The printed form also permits 'Prefer not to disclose' — leave blank in that case."
            },
            {
              "id": "address",
              "kind": "group",
              "label": "Address of the Applicant",
              "fields": [
                { "id": "house_no", "kind": "text", "label": "House No.", "required": true, "validation": { "minLength": 1, "message": "Enter the house number." } },
                { "id": "street", "kind": "text", "label": "Street", "required": true, "validation": { "minLength": 1, "message": "Enter the street." } },
                { "id": "city", "kind": "text", "label": "City", "required": true, "validation": { "minLength": 1, "message": "Enter the city." } },
                { "id": "state", "kind": "text", "label": "State", "required": true, "validation": { "minLength": 1, "message": "Enter the state." } },
                { "id": "country", "kind": "text", "label": "Country", "format": "country", "required": true, "validation": { "minLength": 2, "message": "Enter the country." } },
                {
                  "id": "pin_code",
                  "kind": "number",
                  "label": "Pin code",
                  "format": "pincode",
                  "required": true,
                  "validation": { "pattern": "^[0-9]{6}$", "patternMessage": "An Indian PIN code is 6 digits." }
                },
                {
                  "id": "email",
                  "kind": "text",
                  "label": "Email",
                  "format": "email",
                  "required": true,
                  "helpText": "OTP verification mandatory — will be redacted.",
                  "validation": {
                    "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                    "patternMessage": "Enter a valid email address."
                  },
                  "sensitive": {
                    "pii": true,
                    "redacted": true,
                    "requiresOtp": true,
                    "note": "OTP verification mandatory — will be redacted in the published record."
                  }
                },
                {
                  "id": "contact_number",
                  "kind": "number",
                  "label": "Contact number",
                  "format": "phone",
                  "required": true,
                  "helpText": "OTP verification mandatory — will be redacted.",
                  "sensitive": {
                    "pii": true,
                    "redacted": true,
                    "requiresOtp": true,
                    "note": "OTP verification mandatory — will be redacted in the published record."
                  }
                }
              ]
            }
          ]
        }
      ]
    },

    {
      "id": "category_of_applicant",
      "title": "3B. CATEGORY OF APPLICANT [Please tick (✓) at the appropriate category]",
      "description": "'Natural Person' and 'Other than Natural Person' are mutually exclusive; Small Entity / Startup / Educational institution / Others qualify the latter. The category determines the fee schedule.",
      "fields": [
        {
          "id": "applicant_category",
          "kind": "checkboxGroup",
          "label": "Category of applicant",
          "required": true,
          "selection": "multiple",
          "options": [
            { "value": "natural_person", "label": "Natural Person" },
            { "value": "other_than_natural_person", "label": "Other than Natural Person" },
            { "value": "small_entity", "label": "Small Entity" },
            { "value": "startup", "label": "Startup" },
            { "value": "educational_institution", "label": "Educational institution" },
            { "value": "others", "label": "Others" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Suggest from a Form 28 declaration (small entity / startup / educational institution) if one has been uploaded; the user confirms.",
            "confidence": "low"
          }
        }
      ]
    },

    {
      "id": "inventors",
      "title": "4. INVENTOR(S) [Please tick (✓) at the appropriate category]",
      "fields": [
        {
          "id": "inventors_same_as_applicants",
          "kind": "radio",
          "label": "Are all the inventor(s) same as the applicant(s) named above?",
          "required": true,
          "selection": "single",
          "options": [
            { "value": "yes", "label": "Yes" },
            { "value": "no", "label": "No" }
          ],
          "autofill": {
            "strategy": "derived",
            "derivation": "Compare the inventor and applicant sets in uploaded documents; the user confirms.",
            "confidence": "low"
          }
        },
        {
          "id": "inventor",
          "kind": "group",
          "label": "Inventor",
          "description": "Furnish inventor details where the inventors are not the same as the applicants.",
          "visibleWhen": { "field": "inventors.inventors_same_as_applicants", "op": "equals", "value": "no" },
          "repeatable": { "min": 1, "max": null, "itemLabel": "Inventor" },
          "fields": [
            {
              "id": "name",
              "kind": "text",
              "label": "Name in Full",
              "required": false,
              "requiredWhen": { "field": "inventors.inventors_same_as_applicants", "op": "equals", "value": "no" },
              "helpText": "Name should be given in full, family name in the beginning.",
              "validation": { "minLength": 2, "message": "Enter the inventor's full name." },
              "autofill": {
                "strategy": "direct",
                "sources": [
                  { "sourceType": "form5", "key": "inventor.name" },
                  { "sourceType": "form2_specification", "key": "inventor.name" }
                ],
                "confidence": "high"
              }
            },
            {
              "id": "gender",
              "kind": "radio",
              "label": "Gender (optional, for natural persons)",
              "required": false,
              "selection": "single",
              "options": [
                { "value": "male", "label": "Male" },
                { "value": "female", "label": "Female" },
                { "value": "others", "label": "Others" },
                { "value": "not_disclosed", "label": "Prefer not to disclose" }
              ]
            },
            {
              "id": "nationality",
              "kind": "text",
              "label": "Nationality",
              "format": "country",
              "required": false,
              "requiredWhen": { "field": "inventors.inventors_same_as_applicants", "op": "equals", "value": "no" },
              "autofill": {
                "strategy": "direct",
                "sources": [{ "sourceType": "form5", "key": "inventor.nationality" }],
                "confidence": "medium"
              }
            },
            {
              "id": "age",
              "kind": "number",
              "label": "Age (optional, for natural persons)",
              "required": false,
              "helpText": "In years. The printed form also permits 'Prefer not to disclose' — leave blank in that case."
            },
            {
              "id": "country_of_residence",
              "kind": "text",
              "label": "Country of Residence",
              "format": "country",
              "required": false,
              "requiredWhen": { "field": "inventors.inventors_same_as_applicants", "op": "equals", "value": "no" }
            },
            {
              "id": "address",
              "kind": "group",
              "label": "Address of the Inventor",
              "fields": [
                { "id": "house_no", "kind": "text", "label": "House No.", "required": false },
                { "id": "street", "kind": "text", "label": "Street", "required": false },
                { "id": "city", "kind": "text", "label": "City", "required": false },
                { "id": "state", "kind": "text", "label": "State", "required": false },
                { "id": "country", "kind": "text", "label": "Country", "format": "country", "required": false },
                {
                  "id": "pin_code",
                  "kind": "number",
                  "label": "Pin code",
                  "format": "pincode",
                  "required": false,
                  "validation": { "pattern": "^[0-9]{6}$", "patternMessage": "An Indian PIN code is 6 digits." }
                }
              ]
            }
          ]
        }
      ]
    },

    {
      "id": "title_of_invention",
      "title": "5. TITLE OF THE INVENTION",
      "fields": [
        {
          "id": "invention_title",
          "kind": "textarea",
          "label": "Title of the invention",
          "required": true,
          "helpText": "Must match the title on the specification (Form 2).",
          "validation": { "minLength": 2, "message": "Enter the title of the invention." },
          "autofill": {
            "strategy": "direct",
            "sources": [
              { "sourceType": "form2_specification", "key": "invention.title" },
              { "sourceType": "patent_certificate", "key": "invention.title" }
            ],
            "confidence": "high"
          }
        }
      ]
    },

    {
      "id": "patent_agents",
      "title": "6. AUTHORISED REGISTERED PATENT AGENT(S)",
      "description": "Completed when the application is filed through a patent agent.",
      "fields": [
        {
          "id": "agent",
          "kind": "group",
          "label": "Authorised registered patent agent",
          "repeatable": { "min": 1, "max": null, "itemLabel": "Agent" },
          "fields": [
            {
              "id": "inpa_no",
              "kind": "text",
              "label": "IN/PA No.",
              "required": false,
              "autofill": {
                "strategy": "direct",
                "sources": [{ "sourceType": "form26_authorisation", "key": "agent.inpaNumber" }],
                "confidence": "high"
              }
            },
            {
              "id": "name",
              "kind": "text",
              "label": "Name",
              "required": false,
              "autofill": {
                "strategy": "direct",
                "sources": [{ "sourceType": "form26_authorisation", "key": "agent.name" }],
                "confidence": "high"
              }
            },
            {
              "id": "mobile_no",
              "kind": "number",
              "label": "Mobile No.",
              "format": "phone",
              "required": false,
              "helpText": "OTP verification mandatory — will be redacted.",
              "sensitive": {
                "pii": true,
                "redacted": true,
                "requiresOtp": true,
                "note": "OTP verification mandatory — will be redacted in the published record."
              }
            }
          ]
        }
      ]
    },

    {
      "id": "address_for_service",
      "title": "7. ADDRESS FOR SERVICE OF APPLICANT IN INDIA",
      "description": "The address for service must be an address in India (statutory requirement).",
      "fields": [
        {
          "id": "name",
          "kind": "text",
          "label": "Name",
          "required": true,
          "validation": { "minLength": 2, "message": "Enter the name for service." }
        },
        {
          "id": "postal_address",
          "kind": "textarea",
          "label": "Postal Address",
          "format": "address",
          "required": true,
          "helpText": "Must be an address in India.",
          "validation": { "minLength": 2, "message": "Enter the postal address." },
          "autofill": {
            "strategy": "direct",
            "sources": [{ "sourceType": "form2_specification", "key": "applicant.address" }],
            "confidence": "low"
          }
        },
        { "id": "telephone_no", "kind": "number", "label": "Telephone No.", "format": "phone", "required": false },
        {
          "id": "mobile_no",
          "kind": "number",
          "label": "Mobile No.",
          "format": "phone",
          "required": true,
          "helpText": "OTP verification mandatory — will be redacted.",
          "sensitive": {
            "pii": true,
            "redacted": true,
            "requiresOtp": true,
            "note": "OTP verification mandatory — will be redacted in the published record."
          }
        },
        { "id": "fax_no", "kind": "number", "label": "Fax No.", "required": false },
        {
          "id": "email",
          "kind": "text",
          "label": "E-mail ID",
          "format": "email",
          "required": true,
