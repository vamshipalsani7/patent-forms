                "autofill": {
                  "strategy": "direct",
                  "sources": [{ "sourceType": "priority_document", "key": "foreignApplications[].country" }],
                  "confidence": "medium"
                }
              }
            },
            {
              "id": "application_number",
              "label": "Application Number",
              "cell": {
                "kind": "text",
                "autofill": {
                  "strategy": "direct",
                  "sources": [{ "sourceType": "priority_document", "key": "foreignApplications[].number" }],
                  "confidence": "medium"
                }
              }
            },
            {
              "id": "filing_date",
              "label": "Filing date",
              "cell": {
                "kind": "date",
                "autofill": {
                  "strategy": "direct",
                  "sources": [{ "sourceType": "priority_document", "key": "foreignApplications[].filingDate" }],
                  "confidence": "medium"
                }
              }
            },
            {
              "id": "applicant_name",
              "label": "Name of the applicant",
              "cell": {
                "kind": "text",
                "autofill": {
                  "strategy": "direct",
                  "sources": [{ "sourceType": "priority_document", "key": "applicant.name" }],
                  "confidence": "low"
                }
              }
            },
            {
              "id": "invention_title",
              "label": "Title of the invention",
              "cell": {
                "kind": "text",
                "autofill": {
