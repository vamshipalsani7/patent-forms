          "validation": {
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "patternMessage": "Enter a valid email address."
          },
          "sensitive": {
            "pii": true,
            "redacted": true,
            "requiresOtp": true,
            "note": "OTP verification mandatory — will be redacted in the published record."
          }
        }
      ]
    },

    {
      "id": "convention_particulars",
      "title": "8. IN CASE OF APPLICATION CLAIMING PRIORITY OF APPLICATION FILED IN CONVENTION COUNTRY, PARTICULARS OF CONVENTION APPLICATION",
      "visibleWhen": { "field": "type_of_application.application_type", "op": "in", "value": "convention" },
      "fields": [
        {
          "id": "convention_applications",
          "kind": "table",
